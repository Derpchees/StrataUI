<Window x:Class="Strata.Shell.Notifications.NotificationBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Strata.Shell.Controls"
        Title="{l:T 'Notificaciones'}"
        Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- Avisos apilados; el más nuevo queda junto a la esquina -->
    <ItemsControl x:Name="BannerList" Margin="8">
        <!-- Cada aviso nuevo empieza invisible: su animación de entrada corre un momento después
             (prioridad Loaded) y antes se alcanzaba a dibujar entero un cuadro, con un parpadeo. -->
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Opacity" Value="0" />
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Card" Margin="0,4" CornerRadius="{DynamicResource StrataLargeCornerRadius}"
                        Background="{DynamicResource StrataGlassPopupBrush}"
                        BorderBrush="{DynamicResource StrataFlyoutBorderBrush}" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonUp="Banner_Click">
                    <Grid Margin="14,12,10,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Imagen del aviso (foto del remitente, logotipo del sitio), como en Windows -->
                        <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource NotificationPicture}">
                            <Border.Background><ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill" /></Border.Background>
                        </Border>
                        <Grid Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding AppName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TimeText, Mode=OneWay}" />
                            </TextBlock>
                            <Button Grid.Column="2" Style="{StaticResource FlyoutIconButton}" Width="26" Height="26" Padding="0"
                                    Click="Close_Click" ToolTip="{l:T 'Cerrar'}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="40"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" controls:RichText.Text="{Binding Title}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="58" Foreground="{DynamicResource TextFillColorSecondaryBrush}" controls:RichText.Text="{Binding Body}" />
                        <!-- Imagen del contenido (sticker, foto), debajo del texto -->
                        <Image Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" MaxHeight="140" HorizontalAlignment="Left"
                               Stretch="Uniform" Source="{Binding Hero}" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
