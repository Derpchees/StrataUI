<Window x:Class="Strata.Shell.Notifications.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
        Title="{l:T 'Aviso en pantalla'}"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True"
        IsHitTestVisible="False" FontFamily="{StaticResource UiFont}">
    <!-- Cápsula con ícono, texto y, para volumen y brillo, el nivel. Margen para la sombra. -->
    <Border x:Name="Card" Margin="16" Width="240" MinHeight="52" CornerRadius="26" Padding="18,10"
            Background="{DynamicResource StrataGlassPopupBrush}"
            BorderBrush="{DynamicResource StrataFlyoutBorderBrush}" BorderThickness="1">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" FontSize="18" Margin="0,0,14,0" />
            <!-- Nivel (volumen, brillo) o mensaje (Bloq Mayús…) -->
            <Grid x:Name="LevelPanel" Grid.Column="1" VerticalAlignment="Center" Height="4">
                <Border CornerRadius="2" Background="{DynamicResource StrataForegroundBrush}" Opacity="0.2" />
                <Border x:Name="LevelFill" CornerRadius="2" HorizontalAlignment="Left" Width="0"
                        Background="{DynamicResource StrataAccentBrush}" />
            </Grid>
            <TextBlock x:Name="Message" Grid.Column="1" Grid.ColumnSpan="2" FontSize="13" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StrataForegroundBrush}" />
            <TextBlock x:Name="Percent" Grid.Column="2" Width="32" Margin="12,0,0,0" FontSize="13" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource StrataForegroundBrush}" />
        </Grid>
    </Border>
</Window>
