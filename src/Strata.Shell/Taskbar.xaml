<appbar:AppBarWindow x:Class="Strata.Shell.Taskbar"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
                     xmlns:appbar="clr-namespace:ManagedShell.AppBar;assembly=ManagedShell.AppBar"
                     xmlns:controls="clr-namespace:Strata.Shell.Controls"
                     xmlns:conv="clr-namespace:Strata.Shell.Converters"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     Title="Strata UI"
                     WindowStyle="None"
                     ResizeMode="NoResize"
                     ShowInTaskbar="False"
                     ShowActivated="False"
                     Topmost="True"
                     UseLayoutRounding="True"
                     FontFamily="{StaticResource UiFont}"
                     Background="Transparent">

    <appbar:AppBarWindow.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </appbar:AppBarWindow.Resources>

    <appbar:AppBarWindow.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{l:T 'Configuración de Strata UI'}" FontWeight="SemiBold" Click="OpenHub_Click" />
            <Separator />
            <MenuItem Header="{l:T 'Administrador de tareas'}" Click="TaskManager_Click" />
            <MenuItem Header="{l:T 'Configuración de Windows'}" Click="WindowsSettings_Click" />
            <Separator />
            <MenuItem Header="{l:T 'Reiniciar Strata UI'}" Click="RestartStrata_Click" />
            <MenuItem Header="{l:T 'Salir de Strata UI'}" Click="ExitStrata_Click" />
            <Separator />
            <MenuItem x:Name="VersionItem" IsEnabled="False" />
        </ContextMenu>
    </appbar:AppBarWindow.ContextMenu>

    <!-- La ventana es transparente: el color del tema lo pone este Border (sobre el desenfoque si
         aplica). En temas flotantes se separa de los bordes y toma forma de cápsula. -->
    <Border x:Name="BarBorder" Background="{DynamicResource StrataTaskbarBackgroundBrush}"
            BorderBrush="{DynamicResource StrataTaskbarEdgeBrush}"
            BorderThickness="{DynamicResource StrataTaskbarBorderThickness}"
            CornerRadius="{DynamicResource StrataTaskbarCornerRadius}">
        <!-- En Liquid Glass con refracción en vivo, aquí se inserta la superficie de vidrio (por código) -->
        <Grid x:Name="GlassHost">
            <!-- Brillo interior sutil del vidrio -->
            <Border x:Name="GlassHighlight" IsHitTestVisible="False" Background="{DynamicResource StrataGlassHighlightBrush}"
                    CornerRadius="{DynamicResource StrataTaskbarCornerRadius}"
                    Visibility="{DynamicResource StrataGlassVisibility}" />
            <!-- En barras verticales (izquierda/derecha) las columnas pasan a filas: ver ApplyOrientation -->
            <!-- Zonas a lo largo de la barra: inicio, Inicio con las ventanas, centro y final. Cada
                 elemento va en la zona elegida (Hub o clic derecho); ver Controls/BarZonesPanel -->
            <controls:BarZonesPanel x:Name="MainGrid">
                <StackPanel x:Name="StartZonePanel" controls:BarZonesPanel.Zone="Start" Orientation="Horizontal" Visibility="Collapsed" />

                <!-- Inicio + ventanas abiertas; alineación configurable desde el Hub -->
                <!-- DockPanel (no StackPanel) para que la lista reciba un ancho limitado y pueda desplazarse -->
                <DockPanel x:Name="TaskArea" controls:BarZonesPanel.Zone="Apps" HorizontalAlignment="Center" LastChildFill="True">
                    <!-- El ícono se elige en Hub › Menú Inicio (ver Controls/StartIcons) -->
                    <Button x:Name="StartButton" DockPanel.Dock="Left" Style="{StaticResource TaskbarButton}" Width="44"
                            Padding="0" ToolTip="{l:T 'Inicio'}" Click="StartButton_Click" />

    
                    <!-- Si no caben todas las ventanas, la rueda del mouse desplaza la lista -->
                    <ScrollViewer x:Name="TaskScroller" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" Focusable="False"
                                  PreviewMouseWheel="TaskScroller_PreviewMouseWheel">
                        <!-- Anclados (ver Taskbar.Pins) y luego las demás ventanas abiertas -->
                        <StackPanel x:Name="AppsStack" Orientation="Horizontal">
                        <ItemsControl x:Name="PinnedList" Focusable="False" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TaskButton />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="TaskList" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TaskButton />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
    
                <StackPanel x:Name="CenterZonePanel" controls:BarZonesPanel.Zone="Center" Orientation="Horizontal" Visibility="Collapsed" />

                <!-- Zona del final: bandeja, estado del sistema, reloj y "mostrar escritorio" (los
                     elementos aquí declarados se reparten por zonas en ApplyLayout) -->
                <StackPanel x:Name="StatusPanel" controls:BarZonesPanel.Zone="End" Orientation="Horizontal">
                    <!-- Multimedia: carátula, canción, artista y álbum (clic: abre la app; clic central: pausa)
                         y, si se eligió en el Hub, los controles en la barra -->
                    <StackPanel x:Name="MediaModule" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="MediaButton" Style="{StaticResource TaskbarButton}" Padding="6,0"
                            Click="MediaButton_Click" MouseUp="MediaButton_MouseUp">
                        <StackPanel x:Name="MediaContent" Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="5" VerticalAlignment="Center"
                                    Background="{DynamicResource StrataSurfaceBrush}">
                                <Grid>
                                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xEC4F;" />
                                    <Border CornerRadius="5">
                                        <Border.Background>
                                            <ImageBrush x:Name="MediaCover" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <!-- La app (o el sitio: YouTube…) en la esquina de la carátula -->
                                    <Image x:Name="MediaAppBadge" Width="12" Height="12" Margin="0,0,-3,-3"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="MediaText" Margin="8,0,2,0" MaxWidth="170" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource StrataForegroundBrush}" />
                                <TextBlock x:Name="MediaArtist" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource StrataForegroundBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="MediaControls" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button x:Name="MediaPrevious" Style="{StaticResource TaskbarButton}" Width="28" Padding="0"
                                ToolTip="{l:T 'Anterior'}" Click="MediaPrevious_Click">
                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE892;" />
                        </Button>
                        <Button x:Name="MediaPlay" Style="{StaticResource TaskbarButton}" Width="28" Padding="0" Click="MediaPlay_Click">
                            <TextBlock x:Name="MediaPlayGlyph" Style="{StaticResource IconText}" FontSize="14" Text="&#xE768;" />
                        </Button>
                        <Button x:Name="MediaNext" Style="{StaticResource TaskbarButton}" Width="28" Padding="0"
                                ToolTip="{l:T 'Siguiente'}" Click="MediaNext_Click">
                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE893;" />
                        </Button>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="TrayArea" Orientation="Horizontal">
                        <ToggleButton x:Name="ChevronButton" Style="{StaticResource TaskbarButton}" Width="28"
                                      Padding="0" ToolTip="{l:T 'Mostrar iconos ocultos'}"
                                      IsChecked="{Binding IsOpen, ElementName=HiddenTrayPopup, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=HiddenTrayPopup, Converter={StaticResource InverseBool}}">
                            <!-- Gira: abierta apunta hacia donde se abre el panel; cerrada, al revés (Taskbar.TurnChevron) -->
                            <TextBlock x:Name="ChevronGlyph" Style="{StaticResource IconText}" FontSize="11" Text="&#xE70E;"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </ToggleButton>
                        <Popup x:Name="HiddenTrayPopup" PlacementTarget="{Binding ElementName=ChevronButton}"
                               Placement="Top" VerticalOffset="-8" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource StrataPopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource StrataFlyoutBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource StrataLargeCornerRadius}" Padding="6">
                                <ItemsControl x:Name="HiddenTray" MaxWidth="168">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:TrayIcon />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
    
                        <ItemsControl x:Name="PinnedTray" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TrayIcon />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
    
                    <!-- Módulos de estado: cada uno abre su propio panel y se activa desde el Hub -->
                    <Button x:Name="NetworkButton" Style="{StaticResource StatusButton}"
                            Click="NetworkButton_Click">
                        <TextBlock x:Name="NetworkGlyph" Style="{StaticResource IconText}" Text="&#xE701;" />
                    </Button>
                    <Button x:Name="BluetoothButton" Style="{StaticResource StatusButton}"
                            ToolTip="{l:T 'Bluetooth'}" Click="BluetoothButton_Click">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE702;" />
                    </Button>
                    <Button x:Name="BrightnessButton" Style="{StaticResource StatusButton}"
                            ToolTip="{l:T 'Brillo'}" Visibility="Collapsed" Click="BrightnessButton_Click" MouseWheel="BrightnessButton_MouseWheel">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE706;" />
                    </Button>
                    <Button x:Name="VolumeButton" Style="{StaticResource StatusButton}"
                            ToolTip="{l:T 'Volumen'}" Click="VolumeButton_Click" MouseWheel="VolumeButton_MouseWheel">
                        <TextBlock x:Name="VolumeGlyph" Style="{StaticResource IconText}" Text="&#xE767;" />
                    </Button>
                    <Button x:Name="BatteryButton" Style="{StaticResource StatusButton}" MinWidth="30" Width="NaN" Padding="2,0"
                            Visibility="Collapsed" Click="BatteryButton_Click">
                        <StackPanel x:Name="BatteryContent" Orientation="Horizontal">
                            <TextBlock x:Name="BatteryGlyph" Style="{StaticResource IconText}" />
                            <!-- Porcentaje dentro de la batería (opción del Hub). Mismo estilo que los glifos
                                 de Segoe Fluent de los demás módulos: línea fina, un solo color, su alto. -->
                            <StackPanel x:Name="BatteryPercentIcon" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Grid Width="25" Height="12">
                                    <Border CornerRadius="3" BorderThickness="1"
                                            BorderBrush="{DynamicResource StrataForegroundBrush}" />
                                    <Border x:Name="BatteryLevelFill" Margin="2" CornerRadius="1.5" HorizontalAlignment="Left"
                                            Opacity="0.25" Background="{DynamicResource StrataForegroundBrush}" />
                                    <!-- Rayo junto al número mientras carga -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="BatteryBolt" Margin="0,0,1,0" VerticalAlignment="Center" Visibility="Collapsed"
                                              Stretch="Uniform" Height="9" Fill="{DynamicResource StrataForegroundBrush}"
                                              Data="M5.5,0 L0,7 H3.6 L2.6,12 L8,4.6 H4.4 Z" />
                                        <TextBlock x:Name="BatteryPercentText" FontSize="9" FontWeight="Normal"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource StrataForegroundBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Width="1.5" Height="4" Margin="1,0,0,0" CornerRadius="0,1,1,0"
                                        VerticalAlignment="Center" Background="{DynamicResource StrataForegroundBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
    
                    <!-- Rendimiento: uso (y temperatura) de CPU y GPU, memoria y FPS. Dos líneas cortas:
                         caben también en las barras verticales. Ver Services/SystemMonitor. -->
                    <Button x:Name="CpuButton" Style="{StaticResource MeterButton}" Click="Meter_Click">
                        <StackPanel>
                            <TextBlock x:Name="CpuLabel" Style="{StaticResource MeterDetail}" />
                            <TextBlock x:Name="CpuValue" Style="{StaticResource MeterValue}" Text="CPU" />
                            <TextBlock x:Name="CpuDetail" Style="{StaticResource MeterDetail}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GpuButton" Style="{StaticResource MeterButton}" Click="Meter_Click">
                        <StackPanel>
                            <TextBlock x:Name="GpuLabel" Style="{StaticResource MeterDetail}" />
                            <TextBlock x:Name="GpuValue" Style="{StaticResource MeterValue}" Text="GPU" />
                            <TextBlock x:Name="GpuDetail" Style="{StaticResource MeterDetail}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RamButton" Style="{StaticResource MeterButton}" Click="Meter_Click">
                        <StackPanel>
                            <TextBlock x:Name="RamLabel" Style="{StaticResource MeterDetail}" />
                            <TextBlock x:Name="RamValue" Style="{StaticResource MeterValue}" Text="RAM" />
                            <TextBlock x:Name="RamDetail" Style="{StaticResource MeterDetail}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FpsButton" Style="{StaticResource MeterButton}" Click="Fps_Click">
                        <StackPanel>
                            <TextBlock x:Name="FpsValue" Style="{StaticResource MeterValue}" Text="—" />
                            <TextBlock x:Name="FpsDetail" Style="{StaticResource MeterDetail}" Text="FPS" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FreeRamButton" Style="{StaticResource StatusButton}" ToolTip="{l:T 'Liberar RAM'}"
                            Click="FreeRam_Click">
                        <ui:SymbolIcon x:Name="FreeRamGlyph" Symbol="Broom24" FontSize="16"
                                       Foreground="{DynamicResource StrataForegroundBrush}" />
                    </Button>

                    <Button x:Name="ClockButton" Style="{StaticResource TaskbarButton}" Padding="10,0"
                            Click="ClockButton_Click">
                        <StackPanel x:Name="ClockContent" Orientation="Horizontal">
                            <StackPanel x:Name="ClockPanel" VerticalAlignment="Center">
                                <TextBlock x:Name="TimeText" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource StrataForegroundBrush}" />
                                <TextBlock x:Name="DateText" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource StrataForegroundBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Campana: solo las notificaciones (el reloj abre el calendario) -->
                    <Button x:Name="NotificationsButton" Style="{StaticResource StatusButton}"
                            ToolTip="{l:T 'Notificaciones'}" Click="NotificationsButton_Click">
                        <Grid>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xEA8F;" />
                            <!-- Notificaciones pendientes en el centro de Strata UI -->
                            <Border x:Name="NotificationBadge" Visibility="Collapsed" Margin="0,-7,-9,0" MinWidth="15" Height="15"
                                    CornerRadius="7.5" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource StrataAccentBrush}">
                                <TextBlock x:Name="NotificationCount" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </Button>
    
                    <Border x:Name="ShowDesktopArea" Width="12" Background="Transparent" ToolTip="{l:T 'Mostrar escritorio'}"
                            MouseLeftButtonUp="ShowDesktop_Click">
                        <Border x:Name="ShowDesktopLine" Width="1" Height="16" HorizontalAlignment="Right"
                                Background="{DynamicResource StrataTaskbarBorderBrush}" />
                    </Border>
                </StackPanel>
            </controls:BarZonesPanel>
        </Grid>
    </Border>
</appbar:AppBarWindow>
