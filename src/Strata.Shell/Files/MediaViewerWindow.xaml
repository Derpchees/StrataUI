<ui:FluentWindow x:Class="Strata.Shell.Files.MediaViewerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
                 xmlns:controls="clr-namespace:Strata.Shell.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{l:T 'Visor'}"
                 Icon="pack://application:,,,/Assets/strataui.ico"
                 Width="1100" Height="740" MinWidth="520" MinHeight="380"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <!-- Botón redondo flotante (anterior / siguiente) -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="22" BorderThickness="1"
                                Background="{DynamicResource StrataPopupBackgroundBrush}"
                                BorderBrush="{DynamicResource StrataFlyoutBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrataSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de la barra de controles: solo ícono -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="Root" Background="{DynamicResource StrataHubTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="ViewerTitleBar" Grid.Row="0" Title="{l:T 'Visor'}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{x:Static controls:Logo.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="Stage" Grid.Row="1" ClipToBounds="True" Background="Transparent">
            <!-- Imagen: ajustada a la ventana; la rueda acerca donde está el mouse y se arrastra para moverla -->
            <Grid x:Name="ImageHost" Background="Transparent" Visibility="Collapsed" Cursor="Hand"
                  MouseWheel="ImageHost_MouseWheel" MouseLeftButtonDown="ImageHost_MouseLeftButtonDown"
                  MouseMove="ImageHost_MouseMove" MouseLeftButtonUp="ImageHost_MouseLeftButtonUp"
                  SizeChanged="ImageHost_SizeChanged">
                <Image x:Name="Picture" Stretch="Uniform" Margin="24,8,24,84" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <MatrixTransform x:Name="PictureTransform" />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Video -->
            <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                          Margin="0,0,0,0" Visibility="Collapsed" Stretch="Uniform"
                          MediaOpened="Media_MediaOpened" MediaEnded="Media_MediaEnded" MediaFailed="Media_MediaFailed"
                          MouseLeftButtonUp="Video_MouseLeftButtonUp" />

            <!-- Audio: tarjeta con la nota musical, el título y el artista -->
            <StackPanel x:Name="AudioCard" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,80"
                        Visibility="Collapsed">
                <Border Width="180" Height="180" CornerRadius="28" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="AudioGradientTop" Offset="0" Color="#8B7CF6" />
                            <GradientStop x:Name="AudioGradientBottom" Offset="1" Color="#3F6FDC" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="84" Foreground="White" />
                </Border>
                <TextBlock x:Name="AudioTitle" FontSize="22" FontWeight="SemiBold" Margin="0,22,0,4" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="560" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="AudioArtist" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="560" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- No se pudo mostrar (formato sin códec, archivo dañado) -->
            <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <ui:SymbolIcon Symbol="DocumentError24" FontSize="30" Foreground="{DynamicResource StrataAccentBrush}" />
                </Border>
                <TextBlock Text="{l:T 'No se puede mostrar este archivo aquí'}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0,14,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource CardDescription}" HorizontalAlignment="Center" TextAlignment="Center"
                           MaxWidth="420" />
                <ui:Button Content="{l:T 'Abrir con la app predeterminada'}" Appearance="Primary" HorizontalAlignment="Center"
                           Margin="0,14,0,0" Click="OpenExternal_Click" />
            </StackPanel>

            <!-- Anterior / siguiente -->
            <Button x:Name="PreviousButton" Style="{StaticResource RoundButton}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="16,0,0,40" Click="Previous_Click" ToolTip="{l:T 'Anterior (Izquierda)'}">
                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="18" />
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource RoundButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,16,40" Click="Next_Click" ToolTip="{l:T 'Siguiente (Derecha)'}">
                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="18" />
            </Button>

            <!-- Barra de controles flotante -->
            <Border x:Name="Controls" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,16"
                    CornerRadius="14" Padding="8,6" BorderThickness="1" MinWidth="420"
                    Background="{DynamicResource StrataPopupBackgroundBrush}"
                    BorderBrush="{DynamicResource StrataFlyoutBorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tiempo (video y audio) -->
                    <Grid x:Name="TimeRow" Margin="8,2,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PositionText" FontSize="12" VerticalAlignment="Center" MinWidth="44"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Slider x:Name="Seek" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                Minimum="0" Maximum="1" ValueChanged="Seek_ValueChanged"
                                PreviewMouseLeftButtonDown="Seek_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="Seek_PreviewMouseLeftButtonUp" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="12" VerticalAlignment="Center" MinWidth="44"
                                   TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Izquierda: posición en la carpeta y nombre -->
                        <TextBlock x:Name="CounterText" FontSize="12" VerticalAlignment="Center" Margin="8,0,12,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- Centro: reproducción o zoom -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel x:Name="PlaybackButtons" Orientation="Horizontal">
                                <Button Style="{StaticResource BarButton}" Click="Previous_Click" ToolTip="{l:T 'Anterior (Izquierda)'}">
                                    <ui:SymbolIcon Symbol="Previous24" FontSize="16" />
                                </Button>
                                <Button x:Name="PlayButton" Style="{StaticResource BarButton}" Width="44" Height="44" Click="Play_Click"
                                        ToolTip="{l:T 'Reproducir o pausar (Espacio)'}">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource StrataAccentBrush}">
                                        <ui:SymbolIcon x:Name="PlayIcon" Symbol="Pause24" FontSize="18" Filled="True"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource BarButton}" Click="Next_Click" ToolTip="{l:T 'Siguiente (Derecha)'}">
                                    <ui:SymbolIcon Symbol="Next24" FontSize="16" />
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="ZoomButtons" Orientation="Horizontal">
                                <Button Style="{StaticResource BarButton}" Click="ZoomOut_Click" ToolTip="{l:T 'Alejar (-)'}">
                                    <ui:SymbolIcon Symbol="ZoomOut24" FontSize="16" />
                                </Button>
                                <TextBlock x:Name="ZoomText" FontSize="12" MinWidth="46" TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Button Style="{StaticResource BarButton}" Click="ZoomIn_Click" ToolTip="{l:T 'Acercar (+)'}">
                                    <ui:SymbolIcon Symbol="ZoomIn24" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource BarButton}" Click="Fit_Click" ToolTip="{l:T 'Ajustar a la ventana (0)'}">
                                    <ui:SymbolIcon Symbol="ArrowFit24" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource BarButton}" Click="ActualSize_Click" ToolTip="{l:T 'Tamaño real (1)'}">
                                    <ui:SymbolIcon Symbol="RatioOneToOne24" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource BarButton}" Click="Rotate_Click" ToolTip="{l:T 'Girar (R)'}">
                                    <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Derecha: volumen, pantalla completa y abrir con la app -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel x:Name="VolumePanel" Orientation="Horizontal">
                                <Button Style="{StaticResource BarButton}" Click="Mute_Click" ToolTip="{l:T 'Silenciar (M)'}">
                                    <ui:SymbolIcon x:Name="VolumeIcon" Symbol="Speaker224" FontSize="16" />
                                </Button>
                                <Slider x:Name="VolumeSlider" Width="84" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                        IsMoveToPointEnabled="True" ValueChanged="Volume_ValueChanged" />
                            </StackPanel>
                            <Button x:Name="FullScreenButton" Style="{StaticResource BarButton}" Click="FullScreen_Click"
                                    ToolTip="{l:T 'Pantalla completa (F11)'}">
                                <ui:SymbolIcon x:Name="FullScreenIcon" Symbol="FullScreenMaximize24" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource BarButton}" Click="OpenExternal_Click" ToolTip="{l:T 'Abrir con la app predeterminada'}">
                                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
