<ui:FluentWindow x:Class="Strata.Shell.Files.FilesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
                 xmlns:controls="clr-namespace:Strata.Shell.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{l:T 'Archivos'}"
                 Icon="{x:Static controls:FilesIcon.Bitmap}"
                 Width="1160" Height="740" MinWidth="720" MinHeight="460"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FilesStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Lugar de la barra lateral: carpeta con su símbolo o unidad con el espacio usado -->
            <DataTemplate x:Key="SidePlaceTemplate">
                <Button Style="{StaticResource SideItem}" Click="Place_Click" ToolTip="{Binding Path}"
                        PreviewMouseDown="Place_PreviewMouseDown" ContextMenuOpening="Place_ContextMenuOpening"
                        PreviewMouseLeftButtonDown="Place_PreviewMouseLeftButtonDown" PreviewMouseMove="Place_PreviewMouseMove"
                        AllowDrop="True" DragOver="Place_DragOver" DragLeave="Place_DragLeave" Drop="Place_Drop">
                    <Button.ContextMenu>
                        <ContextMenu />
                    </Button.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="17" Margin="0,0,12,0"
                                       Foreground="{DynamicResource StrataAccentBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,7">
                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="3" MinHeight="3" Margin="0,5,0,1"
                                         Visibility="{Binding IsDrive, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </DataTemplate>

            <!-- Pestaña: la elegida resalta sobre la barra de título, como en un navegador -->
            <DataTemplate x:Key="TabTemplate">
                <Border x:Name="Tab" Height="32" MinWidth="120" MaxWidth="220" Margin="0,0,4,0" Padding="10,0,4,0" CornerRadius="8"
                        Background="Transparent" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                        MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseDown="Tab_MouseDown" ToolTip="{Binding Path}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Folder16" Filled="True" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource StrataAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Button Grid.Column="2" Style="{StaticResource ToolButton}" Width="22" Height="22" Margin="6,0,0,0"
                                Click="CloseTab_Click" ToolTip="{l:T 'Cerrar pestaña (Ctrl+W)'}">
                            <ui:SymbolIcon Symbol="Dismiss12" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter TargetName="Tab" Property="BorderThickness" Value="1" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid x:Name="Root" Background="{DynamicResource StrataHubTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título con las pestañas -->
        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="{l:T 'Archivos'}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{x:Static controls:FilesIcon.Image}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,0,0">
                    <ItemsControl x:Name="TabStrip" ItemTemplate="{StaticResource TabTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Click="NewTab_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T 'Nueva pestaña (Ctrl+T)'}">
                        <ui:SymbolIcon Symbol="Add16" FontSize="14" />
                    </Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral: Este equipo, carpetas, nube, unidades y red -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" controls:SmoothScroll.Enabled="True"
                          Background="Transparent" AllowDrop="True" DragOver="Sidebar_DragOver" Drop="Sidebar_Drop">
                <StackPanel Margin="12,4,8,16">
                    <ItemsControl x:Name="SideFolders" ItemTemplate="{StaticResource SidePlaceTemplate}" />
                    <TextBlock x:Name="SidePinnedTitle" Text="{l:T 'Ancladas'}" FontSize="12" FontWeight="SemiBold" Margin="12,18,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <ItemsControl x:Name="SidePinned" ItemTemplate="{StaticResource SidePlaceTemplate}" />
                    <TextBlock x:Name="SideCloudTitle" Text="{l:T 'Nube'}" FontSize="12" FontWeight="SemiBold" Margin="12,18,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <ItemsControl x:Name="SideCloud" ItemTemplate="{StaticResource SidePlaceTemplate}" />
                    <TextBlock Text="{l:T 'Unidades'}" FontSize="12" FontWeight="SemiBold" Margin="12,18,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="SideDrives" ItemTemplate="{StaticResource SidePlaceTemplate}" />
                    <TextBlock Text="{l:T 'Red'}" FontSize="12" FontWeight="SemiBold" Margin="12,18,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="SideNetwork" ItemTemplate="{StaticResource SidePlaceTemplate}" />
                    <Button Style="{StaticResource SideItem}" Click="ConnectDrive_Click"
                            ToolTip="{l:T 'Asigna una letra a una carpeta compartida de la red. También puedes escribir \\\\servidor en la ruta.'}">
                        <StackPanel Orientation="Horizontal" Margin="0,9">
                            <ui:SymbolIcon Symbol="PlugConnected24" FontSize="17" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{l:T 'Conectar unidad de red'}" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="4,0,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Comandos (sobre el panel activo) -->
                <Grid Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="NewFolderButton" Style="{StaticResource CommandButton}" Click="NewFolder_Click" ToolTip="{l:T 'Nueva carpeta (Ctrl+Mayús+N)'}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource StrataAccentBrush}" />
                                <TextBlock Text="{l:T 'Nueva carpeta'}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="20" Margin="8,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <Button x:Name="CutButton" Style="{StaticResource ToolButton}" Height="34" Click="Cut_Click" ToolTip="{l:T 'Cortar (Ctrl+X)'}">
                            <ui:SymbolIcon Symbol="Cut24" FontSize="16" />
                        </Button>
                        <Button x:Name="CopyButton" Style="{StaticResource ToolButton}" Height="34" Click="Copy_Click" ToolTip="{l:T 'Copiar (Ctrl+C)'}">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                        </Button>
                        <Button x:Name="PasteButton" Style="{StaticResource ToolButton}" Height="34" Click="Paste_Click" ToolTip="{l:T 'Pegar (Ctrl+V)'}">
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="16" />
                        </Button>
                        <Button x:Name="RenameButton" Style="{StaticResource ToolButton}" Height="34" Click="Rename_Click" ToolTip="{l:T 'Cambiar nombre (F2)'}">
                            <ui:SymbolIcon Symbol="Rename24" FontSize="16" />
                        </Button>
                        <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Height="34" Click="Delete_Click" ToolTip="{l:T 'Enviar a la Papelera (Supr)'}">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- En Este equipo no hay orden ni vista que cambiar -->
                        <StackPanel x:Name="ViewControls" Orientation="Horizontal">
                            <Button x:Name="SortButton" Style="{StaticResource CommandButton}" Click="Sort_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSort24" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="{l:T 'Ordenar'}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Padding="2" CornerRadius="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ExtensionsToggle" Style="{StaticResource ViewToggle}" Click="Extensions_Click"
                                                  ToolTip="{l:T 'Mostrar las extensiones de los archivos'}" Margin="0,0,2,0">
                                        <TextBlock Text=".ext" FontSize="11" FontWeight="SemiBold" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="HiddenToggle" Style="{StaticResource ViewToggle}" Click="Hidden_Click"
                                                  ToolTip="{l:T 'Mostrar archivos ocultos'}" Margin="0,0,2,0">
                                        <ui:SymbolIcon Symbol="Eye24" FontSize="15" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="DetailsToggle" Style="{StaticResource ViewToggle}" Click="DetailsView_Click"
                                                  ToolTip="{l:T 'Lista'}">
                                        <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="15" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="GridToggle" Style="{StaticResource ViewToggle}" Click="GridView_Click"
                                                  ToolTip="{l:T 'Cuadrícula'}">
                                        <ui:SymbolIcon Symbol="Grid24" FontSize="15" />
                                    </ToggleButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Padding="2" CornerRadius="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ToggleButton x:Name="SplitToggle" Style="{StaticResource ViewToggle}" Click="Split_Click"
                                          ToolTip="{l:T 'Vista doble: dos carpetas lado a lado (Ctrl+Mayús+D)'}">
                                <ui:SymbolIcon Symbol="SplitVertical24" FontSize="15" />
                            </ToggleButton>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- La pestaña elegida: uno o dos paneles -->
                <ContentControl x:Name="TabHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
