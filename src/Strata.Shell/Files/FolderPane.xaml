<UserControl x:Class="Strata.Shell.Files.FolderPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
             xmlns:controls="clr-namespace:Strata.Shell.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FilesStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RenameBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <EventSetter Event="PreviewKeyDown" Handler="RenameBox_PreviewKeyDown" />
                <EventSetter Event="LostKeyboardFocus" Handler="RenameBox_LostKeyboardFocus" />
            </Style>

            <!-- Vista de lista: ícono y nombre, fecha, tipo y tamaño (anchos iguales a la cabecera) -->
            <DataTemplate x:Key="DetailsTemplate">
                <Grid Height="34" Margin="10,0" Style="{StaticResource FileContent}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="{Binding DateColumn, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <ColumnDefinition Width="{Binding TypeColumn, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="22" HorizontalAlignment="Left">
                        <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <ui:SymbolIcon Style="{StaticResource CloudBadge}" FontSize="11" Margin="0,0,-1,-1" />
                    </Grid>
                    <Grid Margin="32,0,12,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBox Style="{StaticResource RenameBox}" IsVisibleChanged="RenameBox_IsVisibleChanged" VerticalAlignment="Center"
                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding TypeName}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- Vista de cuadrícula: ícono grande o carátula y el nombre debajo -->
            <DataTemplate x:Key="GridTemplate">
                <!-- Ancho fijo: un nombre largo sin espacios no ensancha el mosaico (se partiría y correría la carátula) -->
                <Grid Width="102" Margin="8,10,8,8" Style="{StaticResource FileContent}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Image Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Image Source="{Binding Thumbnail}" Width="96" Height="72" Stretch="Uniform" HorizontalAlignment="Center"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                    <!-- Video: el botón de reproducir sobre su carátula -->
                    <Border Width="26" Height="26" CornerRadius="13" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsVideo}" Value="True" />
                                            <Condition Binding="{Binding HasThumbnail}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="13" Foreground="White" Margin="2,0,0,0" />
                    </Border>
                    <ui:SymbolIcon Style="{StaticResource CloudBadge}" FontSize="16" Margin="0,0,14,6" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBox Style="{StaticResource RenameBox}" IsVisibleChanged="RenameBox_IsVisibleChanged" VerticalAlignment="Top"
                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- Mosaico de la portada: carpeta del usuario, de la nube o de la red -->
            <DataTemplate x:Key="HomeFolderTemplate">
                <Button Style="{StaticResource HubTile}" Width="196" Click="Place_Click" ToolTip="{Binding Path}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="19" Foreground="{DynamicResource StrataAccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="110"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="WrapItems">
                <WrapPanel />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navegación, ruta y búsqueda -->
        <Grid Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Click="Back_Click" ToolTip="{l:T 'Atrás (Alt+Izquierda)'}">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16" />
                </Button>
                <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Click="Forward_Click" ToolTip="{l:T 'Adelante (Alt+Derecha)'}">
                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" />
                </Button>
                <Button x:Name="UpButton" Style="{StaticResource ToolButton}" Click="Up_Click" ToolTip="{l:T 'Subir un nivel (Alt+Arriba)'}">
                    <ui:SymbolIcon Symbol="ArrowUp24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Refresh_Click" ToolTip="{l:T 'Actualizar (F5)'}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                </Button>
            </StackPanel>

            <!-- Ruta en migas; un clic en el espacio libre (o Ctrl+L) la deja escribir -->
            <Border x:Name="AddressBar" Grid.Column="1" Height="36" CornerRadius="8" BorderThickness="1" Cursor="IBeam"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    MouseLeftButtonUp="AddressBar_MouseLeftButtonUp">
                <Grid>
                    <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Margin="6,0">
                        <ItemsControl x:Name="Crumbs" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ChevronRight12" FontSize="10" Margin="2,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding HasChevron, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource CommandButton}" Height="28" Padding="8,0" Click="Crumb_Click"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Home24" FontSize="14" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource StrataAccentBrush}"
                                                               Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox x:Name="PathBox" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center" Padding="10,0" FontSize="13"
                             PreviewKeyDown="PathBox_PreviewKeyDown" LostKeyboardFocus="PathBox_LostKeyboardFocus" />
                </Grid>
            </Border>

            <ui:TextBox x:Name="SearchBox" Grid.Column="2" Width="240" Margin="8,0,0,0" Height="36" Padding="10,0"
                        VerticalContentAlignment="Center" ClearButtonEnabled="True"
                        TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
        </Grid>

        <!-- Contenido: tarjeta con la portada, la lista o la cuadrícula -->
        <Border x:Name="Card" Grid.Row="1" CornerRadius="12" BorderThickness="1" ClipToBounds="True"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                AllowDrop="True" DragOver="Card_DragOver" Drop="Card_Drop">
            <Grid x:Name="Body">
                <!-- Portada (Este equipo): carpetas, nube, unidades, red y recientes -->
                <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Visibility="Collapsed"
                              controls:SmoothScroll.Enabled="True">
                    <StackPanel Margin="24,18,24,24">
                        <TextBlock Text="{l:T 'Carpetas'}" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ItemsControl x:Name="HomeFolders" ItemTemplate="{StaticResource HomeFolderTemplate}" ItemsPanel="{StaticResource WrapItems}" />

                        <TextBlock x:Name="HomeCloudTitle" Text="{l:T 'Nube'}" FontSize="14" FontWeight="SemiBold" Margin="2,16,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
                        <ItemsControl x:Name="HomeCloud" ItemTemplate="{StaticResource HomeFolderTemplate}" ItemsPanel="{StaticResource WrapItems}" />

                        <TextBlock Text="{l:T 'Unidades'}" FontSize="14" FontWeight="SemiBold" Margin="2,16,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ItemsControl x:Name="HomeDrives" ItemsPanel="{StaticResource WrapItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HubTile}" Width="300" Click="Place_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,14,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="5" MinHeight="5" Margin="0,8,0,6">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAlmostFull}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="HomeNetworkTitle" Text="{l:T 'Red'}" FontSize="14" FontWeight="SemiBold" Margin="2,16,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
                        <ItemsControl x:Name="HomeNetwork" ItemTemplate="{StaticResource HomeFolderTemplate}" ItemsPanel="{StaticResource WrapItems}"
                                      Visibility="Collapsed" />

                        <TextBlock x:Name="RecentTitle" Text="{l:T 'Recientes'}" FontSize="14" FontWeight="SemiBold" Margin="2,16,0,8"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ItemsControl x:Name="HomeRecent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SideItem}" Click="Recent_Click" ToolTip="{Binding Path}">
                                        <Grid Margin="0,0,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding When, StringFormat=g}" FontSize="12" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Lista con detalles -->
                <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Header" Margin="16,8,30,4" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition x:Name="HeaderDate" Width="170" />
                            <ColumnDefinition x:Name="HeaderType" Width="170" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="16,0"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <ListBox x:Name="DetailsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="6,4,6,6"
                             SelectionMode="Extended" ItemTemplate="{StaticResource DetailsTemplate}"
                             ItemContainerStyle="{StaticResource FileItem}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" controls:SmoothScroll.Enabled="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>

                <!-- Cuadrícula -->
                <ListBox x:Name="GridList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8"
                         SelectionMode="Extended" ItemTemplate="{StaticResource GridTemplate}"
                         ItemContainerStyle="{StaticResource GridItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" controls:SmoothScroll.Enabled="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ui:VirtualizingWrapPanel ItemSize="124,142" Orientation="Vertical" SpacingMode="Uniform" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- Recuadro de selección (arrastrar desde el espacio libre) -->
                <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Grid x:Name="Marquee" Visibility="Collapsed">
                        <Border CornerRadius="3" Background="{DynamicResource StrataAccentBrush}" Opacity="0.18" />
                        <Border CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource StrataAccentBrush}" />
                    </Grid>
                </Canvas>

                <!-- Reintentar (una carpeta de red que no respondió) -->
                <ui:Button x:Name="RetryButton" Content="{l:T 'Reintentar'}" Appearance="Primary" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,190,0,0" Click="Retry_Click" />

                <!-- Carpeta vacía, sin resultados o sin acceso -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                            IsHitTestVisible="False">
                    <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <ui:SymbolIcon x:Name="EmptyIcon" Symbol="FolderOpen24" FontSize="30" Foreground="{DynamicResource StrataAccentBrush}" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource CardDescription}" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="360" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Estado: cuántos elementos y la selección; a la derecha, avisos breves -->
        <Grid Grid.Row="2" Margin="6,8,6,0">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="MessageText" FontSize="12" HorizontalAlignment="Right" Opacity="0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </Grid>
    </Grid>
</UserControl>
