<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Botón plano con esquinas redondeadas y estados hover/pressed, base de toda la barra. -->
    <Style x:Key="TaskbarButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource StrataForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="2,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource StrataCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrataHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrataPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Módulos del área de estado (red, Bluetooth, brillo, volumen, batería): juntos, sin separación. -->
    <Style x:Key="StatusButton" TargetType="ButtonBase" BasedOn="{StaticResource TaskbarButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Medidores de la barra (CPU, GPU, RAM, FPS): valor arriba y detalle abajo, letra pequeña. -->
    <Style x:Key="MeterButton" TargetType="ButtonBase" BasedOn="{StaticResource TaskbarButton}">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="1,4" />
        <Setter Property="MinWidth" Value="40" />
    </Style>

    <Style x:Key="MeterValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource StrataForegroundBrush}" />
    </Style>

    <Style x:Key="MeterDetail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource StrataForegroundBrush}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Imagen de una notificación (foto del remitente, logotipo del sitio), a la izquierda del texto.
         Contexto: StrataNotification (Picture, PictureIsCircle, HasPicture). -->
    <Style x:Key="NotificationPicture" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,6,10,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="6" />
        <!-- El fondo (ImageBrush con la imagen) va en cada plantilla: un estilo congela sus valores. -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPicture}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding PictureIsCircle}" Value="True">
                <Setter Property="CornerRadius" Value="20" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource StrataForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
