<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 habilita las APIs de WinRT (Wi-Fi, Bluetooth, radios) para los módulos de estado. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StrataUI</AssemblyName>
    <RootNamespace>Strata.Shell</RootNamespace>
    <!-- Estructuras grandes de NVAPI (Services/Vendors/NvidiaSettings) en la pila. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\strataui.ico</ApplicationIcon>
    <!-- El DPI lo declara el manifiesto (correcto para WPF); el aviso es solo para apps WinForms. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Memoria: el recolector concurrente reserva un hilo y memoria extra que un shell en reposo
         no necesita; ConserveMemory compacta antes para no acumular huecos. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Strata.Tests" />
    <!-- El módulo de optimización (src/Strata.Optimization) usa los tipos internos de la app. -->
    <InternalsVisibleTo Include="StrataUI.Optimization" />
    <InternalsVisibleTo Include="StrataUI.Files" />
    <InternalsVisibleTo Include="StrataUI.Sensors" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms solo se usa para Screen/SystemInformation; evitamos choques de nombres con WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\strataui.ico" />
    <!-- Traducciones de la interfaz (ver Services/Localization/Loc.cs) -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="Strata.Shell.Localization.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <!-- Emojis a color en las notificaciones: DirectWrite los dibuja (WPF no sabe), ver Services/Emoji -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Comprimidos: 7z.dll de 7-Zip (LGPL). Solo la carga el proceso aparte (Services/Files/ArchiveHost). -->
    <PackageReference Include="7z.Libs" Version="26.5.0" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(Pkg7z_Libs)\bin\x64\7z.dll" Link="7z.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(Pkg7z_Libs)\bin\License.txt" Link="7z-License.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
