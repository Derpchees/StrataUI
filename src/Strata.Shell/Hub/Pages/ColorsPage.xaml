<Page x:Class="Strata.Shell.Hub.Pages.ColorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Colores'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="Color24" Title="{l:T 'Colores'}"
                            Subtitle="{l:T 'Color de acento, colores propios para la barra y los paneles, y fondo de pantalla.'}" />

            <!-- ── Acento ──────────────────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Color de acento'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Color24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Origen del color'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'Los esquemas de color (Nord, Dracula…) traen su propio acento si aquí se deja el de Windows. Con Aplicar el tema a Windows, Windows también usa el color del fondo o el propio.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0"
                            Background="{DynamicResource StrataAccentBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="AccentSourceBox" MinWidth="200" SelectionChanged="AccentSource_Changed">
                        <ComboBoxItem Content="{l:T 'El de Windows'}" Tag="Windows" />
                        <ComboBoxItem x:Name="WallpaperAccentItem" Content="{l:T 'Del fondo de pantalla'}" Tag="Wallpaper" />
                        <ComboBoxItem Content="{l:T 'Elegido por mí'}" Tag="Custom" />
                    </ComboBox>
                </StackPanel>
            </ui:CardControl>

            <!-- Wallpaper Engine cambia el acento de Windows con cada fondo: las dos cosas se pisarían -->
            <ui:InfoBar x:Name="WallpaperEngineBar" Margin="0,0,0,4" Severity="Warning" IsClosable="False" IsOpen="False"
                        Title="{l:T 'Wallpaper Engine está cambiando el color de Windows'}"
                        Message="{l:T 'Mientras tenga activado Ajustar el color de Windows (Configuración › General), Strata UI no saca el color del fondo ni cambia el acento de Windows. Desactívalo ahí y esta opción vuelve sola.'}" />

            <Border x:Name="SwatchPanel" Margin="0,0,0,4" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <WrapPanel x:Name="Swatches" />
            </Border>

            <!-- ── Colores propios ─────────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Colores propios'}" />
            <TextBlock Style="{StaticResource CardDescription}" Margin="2,0,0,10" TextWrapping="Wrap"
                       Text="{l:T 'Encima del tema de cada monitor. El texto se pone claro u oscuro solo, según el color, para que siempre se lea.'}" />
            <StackPanel x:Name="CustomColors" />

            <!-- ── Fondo de pantalla ───────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Fondo de pantalla'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="160" Height="90" CornerRadius="6" ClipToBounds="True" Margin="0,0,16,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Image x:Name="WallpaperPreview" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Imagen del escritorio'}" />
                            <TextBlock x:Name="WallpaperPath" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="RestoreWallpaperButton" Content="{l:T 'Restaurar original'}" Margin="0,0,8,0"
                               Click="RestoreWallpaper_Click" />
                    <ui:Button Content="{l:T 'Elegir imagen…'}" Appearance="Primary" Click="ChooseWallpaper_Click" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
