<Page x:Class="Strata.Shell.Hub.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Notificaciones'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="Alert24" Title="{l:T 'Notificaciones'}"
                            Subtitle="{l:T 'Centro de notificaciones junto al reloj (o Win+N) y avisos en el monitor y la esquina que elijas.'}" />

            <!-- Sin permiso de Windows -->
            <ui:InfoBar x:Name="DeniedBar" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,0,0,12"
                        Title="{l:T 'Windows no permite a Strata UI leer las notificaciones.'}"
                        Message="{l:T 'Actívalo en Configuración › Privacidad y seguridad › Notificaciones.'}" />

            <!-- ── En este monitor ───────────────────────────────────────────── -->
            <StackPanel x:Name="ScreenOptions">
                <TextBlock Style="{StaticResource HubSectionTitle}" Margin="2,8,0,8" Text="{l:T 'Dónde salen los avisos'}" />

                <!-- El monitor y la esquina se eligen arrastrando el aviso de ejemplo en el modo edición -->
                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowExpand24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Monitor y esquina'}" />
                            <TextBlock x:Name="CornerText" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Content="{l:T 'Cambiar en el modo edición'}" Click="EditLayout_Click" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Play24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Probar'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Muestra un aviso de ejemplo donde aparecerán.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{l:T 'Mostrar un aviso de prueba'}" Icon="{ui:SymbolIcon Alert24}" Click="Test_Click" />
                </ui:CardControl>
            </StackPanel>

            <!-- ── Para todos los monitores ──────────────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Para todos los monitores'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="AlertOn24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Centro de notificaciones de Strata UI'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Desactivado, el reloj y Win+N abren el de Windows.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="EnabledSwitch" Click="Enabled_Click" />
            </ui:CardControl>

            <StackPanel x:Name="Options">
                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="ChatBubblesQuestion24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar avisos emergentes'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Un aviso breve cuando llega una notificación. No aparecen con una app a pantalla completa.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="BannersSwitch" Click="Banners_Click" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Speaker224" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Sonido de notificación'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Un tono corto con cada aviso emergente.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="SoundsSwitch" Click="Sounds_Click" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="SpeakerMute24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Solo el sonido de Strata UI'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Silencia el sonido que Windows pone a las notificaciones de cada app (WhatsApp, navegadores…). El que tocan las páginas web se quita en cada sitio.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="MuteWindowsSoundsSwitch" Click="MuteWindowsSounds_Click" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="AlertSnooze24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'No molestar'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Las notificaciones llegan al centro, pero sin avisos.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="DndSwitch" Click="Dnd_Click" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Timer24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Duración'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Cuánto tiempo se ve cada aviso. Con el mouse encima no se cierra.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="DurationBox" MinWidth="160" SelectionChanged="Duration_Changed">
                        <ComboBoxItem Content="{l:T '4 segundos'}" Tag="4" />
                        <ComboBoxItem Content="{l:T '6 segundos'}" Tag="6" />
                        <ComboBoxItem Content="{l:T '10 segundos'}" Tag="10" />
                        <ComboBoxItem Content="{l:T '20 segundos'}" Tag="20" />
                    </ComboBox>
                </ui:CardControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
