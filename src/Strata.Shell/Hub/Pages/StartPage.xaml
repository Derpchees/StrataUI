<Page x:Class="Strata.Shell.Hub.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Menú Inicio'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="Grid24" Title="{l:T 'Menú Inicio'}" Subtitle="{l:T 'Estilo del menú, apps ancladas y botones.'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Grid24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Estilo'}" />
                        <TextBlock x:Name="StyleDescription" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="StyleBox" MinWidth="210" SelectionChanged="Style_Changed">
                    <ComboBoxItem Content="{l:T 'Windows 11'}" />
                    <ComboBoxItem Content="{l:T 'Lista (Windows 10/7)'}" />
                    <ComboBoxItem Content="{l:T 'Pantalla completa'}" />
                    <ComboBoxItem Content="{l:T 'Compacto'}" />
                    <ComboBoxItem Content="{l:T 'Solo búsqueda'}" />
                    <ComboBoxItem Content="{l:T 'Íconos'}" />
                    <ComboBoxItem Content="{l:T 'Perfil'}" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ResizeImage24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Tamaño de los íconos'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Apps ancladas, listas y cuadrículas del menú. El tamaño del menú se cambia arrastrando sus bordes.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="IconSizeBox" MinWidth="210" SelectionChanged="IconSize_Changed">
                    <ComboBoxItem Content="{l:T 'Pequeños'}" />
                    <ComboBoxItem Content="{l:T 'Medianos'}" />
                    <ComboBoxItem Content="{l:T 'Grandes'}" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="TextCaseTitle24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Nombres de las apps ancladas'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Sin ellos el menú queda más limpio; el nombre aparece al pasar el mouse.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="PinnedLabelsSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Ícono del botón Inicio'}" />
            <WrapPanel x:Name="IconGallery" Margin="0,0,0,4" />

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Contenido'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Pin24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar apps ancladas'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'En los estilos Windows 11, Perfil y Pantalla completa puedes arrastrarlas para ordenarlas, soltar una sobre otra para crear una carpeta y crear secciones con nombre (doble clic en el título para renombrar).'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:T 'Restablecer'}" Margin="0,0,12,0" Click="ResetPinned_Click" />
                    <ui:ToggleSwitch x:Name="PinnedSwitch" Click="Options_Changed" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="AppsList24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar todas las apps'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'La lista completa o el botón &quot;Todas las apps&quot;. La búsqueda sigue funcionando.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AllAppsSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="History24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar archivos recientes'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'En el estilo Windows 11, debajo de las apps ancladas'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="RecentSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Person24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar usuario'}" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="UserSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ImageCircle24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Usar la foto de la cuenta'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Si no hay foto, se muestran tus iniciales'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="PictureSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Botones de la parte inferior'}" />
            <TextBlock Style="{StaticResource CardDescription}" Margin="0,-4,0,8"
                       Text="{l:T 'Aparecen a la derecha del pie del menú, en este orden. Arrástralos para ordenarlos; con + agregas uno y con × lo quitas.'}" />
            <Border Padding="16,12,12,6" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <ui:Button x:Name="FooterAddButton" DockPanel.Dock="Right" VerticalAlignment="Top" Padding="8,5"
                               Icon="{ui:SymbolIcon Add24}" ToolTip="{l:T 'Agregar un botón'}" Click="FooterAdd_Click" />
                    <WrapPanel x:Name="FooterChips" MinHeight="34" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Teclado'}" />
            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Abrir con la tecla Windows'}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="{l:T 'La tecla Windows abre el menú de Strata UI en lugar del de Windows. Los atajos como Win+E o Win+R siguen funcionando.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="WinKeySwitch" Click="Options_Changed" />
            </ui:CardControl>
            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Desktop24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Abrir en el monitor del mouse'}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="{l:T 'La tecla Windows abre el menú en el monitor donde está el puntero, si ahí hay una barra con Inicio. Si no, en la barra principal.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="MouseMonitorSwitch" Click="Options_Changed" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
