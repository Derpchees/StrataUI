<Page x:Class="Strata.Shell.Hub.Pages.TaskbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Barra de tareas'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="PanelBottom20" Title="{l:T 'Barra de tareas'}"
                            Subtitle="{l:T 'Las apps abiertas y el cambio de ventana con Alt+Tab.'}" />

            <!-- ── Apps abiertas (de este monitor) ──────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Apps abiertas'}" />
            <hub:ScreenPicker />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowMultiple20" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Vista previa de las ventanas'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al pasar el mouse por una app abierta se ve su ventana en vivo. Arrastra los botones para ordenarlos.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="PreviewsSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Stack24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Agrupar las ventanas de cada app'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Un solo botón por app, que se ve apilado si tiene varias ventanas; al hacer clic se elige cuál abrir. YouTube, WhatsApp Web y otros sitios cuentan como su propia app.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="CombineSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl x:Name="AppsModeCard" Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowMultiple16" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar las apps abiertas en'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'En qué barras aparece cada ventana.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="AppsModeBox" MinWidth="260" SelectionChanged="AppsMode_Changed">
                    <ComboBoxItem Content="{l:T 'Igual que Windows'}" Tag="Windows" />
                    <ComboBoxItem Content="{l:T 'Todas las barras'}" Tag="AllTaskbars" />
                    <ComboBoxItem Content="{l:T 'La principal y la del monitor de la ventana'}" Tag="MainAndOwn" />
                    <ComboBoxItem Content="{l:T 'Solo la del monitor de la ventana'}" Tag="OwnOnly" />
                </ComboBox>
            </ui:CardControl>

            <!-- ── Cambiar de ventana ─────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Cambiar de ventana'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="TabDesktopMultiple20" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Alt+Tab de Strata UI'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Cambia de ventana con vistas en vivo. Las flechas eligen, Supr o la rueda del mouse cierran una ventana y Esc cancela. Apagado, se usa el de Windows.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AltTabSwitch" Click="AltTab_Changed" />
            </ui:CardControl>

            <ui:CardControl x:Name="AltTabMonitorCard" Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Desktop24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Alt+Tab por monitor'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Alt+Tab muestra solo las ventanas del monitor de la ventana activa. Con Ctrl+Alt+Tab se ven todas.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AltTabMonitorSwitch" Click="AltTab_Changed" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
