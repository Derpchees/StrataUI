<Page x:Class="Strata.Shell.Hub.Pages.TaskbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Barra de tareas'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="PanelBottom20" Title="{l:T 'Barra de tareas'}"
                            Subtitle="{l:T 'El diseño de cada monitor se arma en el modo edición; aquí, las apps abiertas y las lecturas avanzadas.'}" />

            <!-- ── Modo edición: barras, elementos, sus opciones y widgets ──────── -->
            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="DesignIdeas24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Modo edición'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'Arma las barras, los elementos y los widgets de cada monitor sobre la pantalla misma, arrastrando. Clic derecho en una barra: tamaño, estilo y alineación; en un elemento, sus opciones. Nada cambia hasta que lo apliques.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Edit24}" Content="{l:T 'Editar diseño'}" Click="EditLayout_Click" />
            </ui:CardControl>
            <!-- Con el modo edición abierto: la biblioteca, para arrastrar desde aquí a las capas -->
            <Border x:Name="EditLibraryHost" Visibility="Collapsed" Margin="0,0,0,6" Padding="18,10,18,12" CornerRadius="8"
                    BorderThickness="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />

            <!-- Qué tiene ahora cada monitor -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Diseño actual'}" />
            <Border Margin="0,0,0,6" Padding="18,10,18,12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel x:Name="LayoutSummary" />
            </Border>

            <!-- ── Apps abiertas (de este monitor) ──────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Apps abiertas'}" />
            <hub:ScreenPicker />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowMultiple20" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Vista previa de las ventanas'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al pasar el mouse por una app abierta se ve su ventana en vivo. Arrastra los botones para ordenarlos.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="PreviewsSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Stack24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Agrupar las ventanas de cada app'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Un solo botón por app, que se ve apilado si tiene varias ventanas; al hacer clic se elige cuál abrir. YouTube, WhatsApp Web y otros sitios cuentan como su propia app.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="CombineSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <!-- ── Para todos los monitores ──────────────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Para todos los monitores'}" />

            <ui:CardControl x:Name="AppsModeCard" Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowMultiple16" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar las apps abiertas en'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'En qué barras aparece cada ventana.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="AppsModeBox" MinWidth="260" SelectionChanged="AppsMode_Changed">
                    <ComboBoxItem Content="{l:T 'Igual que Windows'}" Tag="Windows" />
                    <ComboBoxItem Content="{l:T 'Todas las barras'}" Tag="AllTaskbars" />
                    <ComboBoxItem Content="{l:T 'La principal y la del monitor de la ventana'}" Tag="MainAndOwn" />
                    <ComboBoxItem Content="{l:T 'Solo la del monitor de la ventana'}" Tag="OwnOnly" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardExpander Style="{StaticResource HubExpander}" Icon="{ui:SymbolIcon DeveloperBoard24}" IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Lecturas avanzadas'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'El uso de CPU, GPU y RAM se lee sin permisos especiales. Las temperaturas y los FPS necesitan las lecturas avanzadas: Windows pide permiso la primera vez y después de cada actualización de Strata UI.'}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Grid Style="{StaticResource HubSubOption}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Estado'}" />
                            <TextBlock x:Name="SensorsState" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button x:Name="SensorsButton" Click="Sensors_Click" />
                            <ui:Button x:Name="SensorsRemoveButton" Margin="8,0,0,0" Content="{l:T 'Quitar el permiso'}"
                                       ToolTip="{l:T 'Borra la tarea con permiso de administrador (pide permiso para borrarla)'}" Click="SensorsRemove_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource HubSubOption}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Iniciarlas al abrir Strata UI'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Sin pedir permiso, una vez concedido'}" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="SensorsStartupSwitch" HorizontalAlignment="Right" Click="Global_Changed" />
                    </Grid>
                    <ui:InfoBar x:Name="PawnIoBar" Margin="0,4,0,0" Severity="Informational" IsClosable="False" IsOpen="False"
                                Title="{l:T 'Temperatura de la CPU'}"
                                Message="{l:T 'Windows solo deja leerla con el controlador PawnIO (gratuito y firmado). Instálalo desde pawnio.eu y reinicia las lecturas avanzadas.'}" />
                    <ui:Button x:Name="PawnIoButton" Margin="0,6,0,0" HorizontalAlignment="Left" Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowDownload24}" Content="{l:T 'Instalar PawnIO'}" Click="PawnIo_Click" />
                </StackPanel>
            </ui:CardExpander>

            <ui:CardControl Style="{StaticResource HubCard}" Icon="{ui:SymbolIcon Broom24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Liberar RAM'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'Vacía la memoria que las apps no están usando y la caché en espera. Usa el mismo permiso que las lecturas avanzadas.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
