<Page x:Class="Strata.Shell.Hub.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Tema'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="PaintBrush24" Title="{l:T 'Tema'}" Subtitle="{l:T 'Estilo de la barra, los paneles y el Hub, y sus animaciones.'}" />

            <TextBlock Style="{StaticResource HubSectionTitle}" Margin="2,8,0,4" Text="{l:T 'Tema'}" />
            <TextBlock Style="{StaticResource CardDescription}" Margin="2,0,0,10" TextWrapping="Wrap"
                       Text="{l:T 'De la barra, los paneles, el menú Inicio y el Hub, en todos los monitores.'}" />
            <TextBlock Style="{StaticResource CardTitle}" Margin="2,0,0,8" Text="{l:T 'Estilos'}" />
            <WrapPanel x:Name="ThemeGallery" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource CardTitle}" Margin="2,4,0,8" Text="{l:T 'Esquemas de color'}" />
            <WrapPanel x:Name="SchemeGallery" Margin="0,0,0,8" />
            <TextBlock x:Name="ImportedTitle" Style="{StaticResource CardTitle}" Margin="2,4,0,8" Text="{l:T 'Importados'}" Visibility="Collapsed" />
            <WrapPanel x:Name="ImportedGallery" Margin="0,0,0,8" />


            <!-- ── Efectos ───────────────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Efectos'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowSettings20" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Aplicar el tema a Windows'}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="{l:T 'Modo claro/oscuro del sistema y fondo del tema en el Explorador y el Panel de control. El contenido de esas ventanas sigue siendo sólido.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="WindowsThemeSwitch" Click="WindowsTheme_Click" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Animaciones'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Estilo'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Cómo aparecen y se van los paneles, el menú Inicio, los avisos, los menús y las páginas del Hub.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="AnimationBox" MinWidth="180" SelectionChanged="Animation_Changed">
                    <ComboBoxItem Content="{l:T 'Deslizar'}" Tag="Slide" />
                    <ComboBoxItem Content="{l:T 'Desvanecer'}" Tag="Fade" />
                    <ComboBoxItem Content="{l:T 'Acercar'}" Tag="Zoom" />
                    <ComboBoxItem Content="{l:T 'Rebote'}" Tag="Pop" />
                    <ComboBoxItem Content="{l:T 'Subir desde lejos'}" Tag="Rise" />
                    <ComboBoxItem Content="{l:T 'Sin animación'}" Tag="None" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Timer24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Velocidad'}" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ComboBox x:Name="SpeedBox" MinWidth="180" SelectionChanged="Animation_Changed">
                    <ComboBoxItem Content="{l:T 'Rápida'}" Tag="Fast" />
                    <ComboBoxItem Content="{l:T 'Normal'}" Tag="Normal" />
                    <ComboBoxItem Content="{l:T 'Lenta'}" Tag="Slow" />
                </ComboBox>
            </ui:CardControl>


        </StackPanel>
    </ScrollViewer>
</Page>
