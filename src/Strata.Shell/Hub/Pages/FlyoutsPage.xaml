<Page x:Class="Strata.Shell.Hub.Pages.FlyoutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Paneles'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="PanelRight24" Title="{l:T 'Paneles'}"
                            Subtitle="{l:T 'Los avisos que aparecen junto a la barra al cambiar el volumen o el brillo y al pulsar las teclas de bloqueo.'}" />
            <hub:ScreenPicker />

            <TextBlock Style="{StaticResource CardDescription}" Margin="2,8,0,10" TextWrapping="Wrap"
                       Text="{l:T 'Cada monitor muestra los suyos junto a su barra. Si el panel de ese control ya está abierto, el aviso no aparece (el cambio se ve ahí).'}" />

            <ui:CardControl Style="{StaticResource HubCard}" Icon="{ui:SymbolIcon Speaker224}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Volumen'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al subir o bajar el volumen con el teclado, la rueda o el panel'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="VolumeSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}" Icon="{ui:SymbolIcon SpeakerMute24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Silencio'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al silenciar o quitar el silencio'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="MuteSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}" Icon="{ui:SymbolIcon BrightnessHigh24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Brillo'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al cambiar el brillo de este monitor'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BrightnessSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}" Icon="{ui:SymbolIcon KeyboardShift24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Bloq Mayús'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al activar o desactivar las mayúsculas'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="CapsSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}" Icon="{ui:SymbolIcon NumberSymbol24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Bloq Num'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al activar o desactivar el teclado numérico'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NumSwitch" Click="Options_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}" Icon="{ui:SymbolIcon ArrowSortDown24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Bloq Despl'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al activar o desactivar el bloqueo de desplazamiento'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ScrollSwitch" Click="Options_Changed" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
