<Page x:Class="Strata.Shell.Hub.Pages.MediaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Control multimedia'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="MusicNote224" Title="{l:T 'Control multimedia'}"
                            Subtitle="{l:T 'Lo que suena en cualquier app, en la barra.'}" />
            <hub:ScreenPicker />

            <TextBlock Style="{StaticResource CardDescription}" Margin="2,0,0,10" TextWrapping="Wrap"
                       Text="{l:T 'Carátula, canción, artista y álbum de lo que suena en cualquier app (Spotify, Reproductor multimedia, Deezer, YouTube en el navegador…). Clic: abre la app; clic central: pausa. Se agrega a una barra en el modo edición.'}" />

            <ui:CardControl Style="{StaticResource HubCard}" Icon="{ui:SymbolIcon Play24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Controles multimedia'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Anterior, reproducir o pausar y siguiente junto a la canción'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="MediaControlsSwitch" Click="Options_Changed" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
