<Page x:Class="Strata.Shell.Hub.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:controls="clr-namespace:Strata.Shell.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Dashboard'}"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <!-- Medidor del equipo: nombre, porcentaje grande, barra y detalle -->
        <DataTemplate x:Key="StatTemplate">
            <Border Style="{StaticResource DashCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Foreground="{DynamicResource StrataAccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,6"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Acceso a una sección: ícono y nombre -->
        <DataTemplate x:Key="TileContent">
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Foreground="{DynamicResource StrataAccentBrush}" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <!-- Cabecera: degradado del color de acento, versión y estado de las actualizaciones -->
            <Border x:Name="Hero" CornerRadius="14" Padding="22,18" Margin="0,4,8,0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" Margin="0,0,16,0" Background="#33FFFFFF">
                        <Image Source="{x:Static controls:Logo.Image}" Width="36" Height="36" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Greeting" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="HeroSubtitle" FontSize="13" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="UpdateChip" Grid.Column="2" VerticalAlignment="Center" Cursor="Hand" Click="UpdateChip_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="16" Padding="14,8" Background="#33FFFFFF">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="UpdateIcon" Symbol="CheckmarkCircle24" FontSize="16" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock x:Name="UpdateText" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Estado del equipo, en vivo -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Tu equipo'}" />
            <ItemsControl x:Name="Stats" ItemTemplate="{StaticResource StatTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Interruptores y acciones más usados -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Rápido'}" />
            <UniformGrid Columns="3">
                <Border Style="{StaticResource DashCard}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="DndSwitch" DockPanel.Dock="Right" VerticalAlignment="Top" Click="Dnd_Click" />
                        <StackPanel Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="AlertSnooze24" FontSize="20" HorizontalAlignment="Left" Foreground="{DynamicResource StrataAccentBrush}" />
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,8,0,2" Text="{l:T 'No molestar'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Sin avisos emergentes'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource DashCard}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="SoundSwitch" DockPanel.Dock="Right" VerticalAlignment="Top" Click="Sound_Click" />
                        <StackPanel Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Speaker224" FontSize="20" HorizontalAlignment="Left" Foreground="{DynamicResource StrataAccentBrush}" />
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,8,0,2" Text="{l:T 'Sonido de notificación'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Un tono con cada aviso'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource DashCard}">
                    <DockPanel>
                        <ui:ToggleSwitch x:Name="AutoStartSwitch" DockPanel.Dock="Right" VerticalAlignment="Top" Click="AutoStart_Click" />
                        <StackPanel Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Rocket24" FontSize="20" HorizontalAlignment="Left" Foreground="{DynamicResource StrataAccentBrush}" />
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,8,0,2" Text="{l:T 'Iniciar con Windows'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Al iniciar sesión'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <WrapPanel Margin="0,4,0,0">
                <ui:Button x:Name="FreeRamButton" Margin="0,0,8,8" Icon="{ui:SymbolIcon Broom24}" Content="{l:T 'Liberar RAM'}" Click="FreeRam_Click" />
                <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon ArrowSync24}" Content="{l:T 'Reiniciar Strata UI'}" Click="Restart_Click" />
                <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Power24}" Content="{l:T 'Salir de Strata UI'}" Click="Exit_Click" />
            </WrapPanel>
            <TextBlock x:Name="ActionStatus" Style="{StaticResource CardDescription}" Margin="2,0,0,0" Visibility="Collapsed" />

            <!-- Accesos a cada sección -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Personalizar'}" />
            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource HubTile}" Click="Tile_Click"
                                Content="{Binding}" ContentTemplate="{StaticResource TileContent}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
