<Page x:Class="Strata.Shell.Hub.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Strata.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'General'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="Settings24" Title="{l:T 'General'}" Subtitle="{l:T 'Inicio con Windows, idioma y datos de Strata UI.'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Rocket24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Iniciar Strata UI con Windows'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Reemplaza la barra de Windows en cuanto inicias sesión'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutoStartSwitch" Click="AutoStart_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Window24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Abrir el Hub al iniciar con Windows'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Si está apagado, al iniciar sesión solo aparecen las barras. El Hub se abre desde el ícono de Strata UI en la bandeja.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="HubAtStartupSwitch" Click="HubAtStartup_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Usar Archivos de Strata UI como explorador'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Win+E, el botón Explorador y las carpetas del menú Inicio y de Win+X abren Archivos. Apagado, abren el Explorador de Windows.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ReplaceExplorerSwitch" Click="ReplaceExplorer_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="LocalLanguage24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Idioma'}" />
                        <TextBlock x:Name="LanguageHint" Style="{StaticResource CardDescription}"
                                   Text="{l:T 'Por defecto, el de Windows. Se aplica al reiniciar Strata UI.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="LanguageRestart" Content="{l:T 'Reiniciar ahora'}" Margin="0,0,12,0"
                               Visibility="Collapsed" Click="Restart_Click" />
                    <ComboBox x:Name="LanguageBox" MinWidth="200" SelectionChanged="Language_Changed">
                        <ComboBoxItem Content="{l:T 'Igual que Windows'}" Tag="auto" />
                        <ComboBoxItem Content="Español" Tag="es" />
                        <!-- Los demás idiomas (incluidos y propios) se agregan desde el código -->
                    </ComboBox>
                </StackPanel>
            </ui:CardControl>

            <!-- ── Tu configuración: llevarla a otro equipo o guardarla ───────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Tu configuración'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowExportLtr24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Exportar configuración'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'Guarda en un .zip tus ajustes y los módulos importados (temas, animaciones, widgets…), para respaldarlos o llevarlos a otro equipo.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:T 'Exportar…'}" Icon="{ui:SymbolIcon ArrowExportLtr24}" Click="Export_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowImport24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Importar configuración'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'Reemplaza tus ajustes por los de un archivo exportado y reinicia Strata UI. Lo propio de este equipo (monitores y respaldos de Windows) se conserva.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:T 'Importar…'}" Icon="{ui:SymbolIcon ArrowImport24}" Click="Import_Click" />
            </ui:CardControl>
            <TextBlock x:Name="TransferStatus" Style="{StaticResource CardDescription}" Margin="2,4,0,0" Visibility="Collapsed" />

            <!-- ── Módulos ───────────────────────────────────────────────────── -->
            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Módulos'}" />

            <ui:CardControl x:Name="OptimizationCard" Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Flash24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Módulo de optimización'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'Instalado. Al quitarlo, los cambios que ya hizo en Windows se quedan: para deshacerlos, usa Optimización › Respaldo antes.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:T 'Quitar'}" Click="RemoveOptimization_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="PuzzlePiece24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Crear tus propios módulos'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'Temas, animaciones, widgets y aspectos del menú Inicio en archivos .json. Se importan en la página de cada uno.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{l:T 'Abrir carpeta'}" Margin="0,0,8,0" Click="OpenModules_Click" />
                    <ui:Button Content="{l:T 'Ver el formato'}" Icon="{ui:SymbolIcon Open24}" Click="ModuleFormat_Click" />
                </StackPanel>
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="Strata UI" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Info24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="DataPathText" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:T 'Abrir carpeta de datos'}" Click="OpenData_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Reiniciar Strata UI'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Vuelve a cargar la barra y los servicios'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:T 'Reiniciar'}" Click="Restart_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Power24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Salir de Strata UI'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Cierra Strata UI y vuelve la barra de tareas de Windows'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:T 'Salir'}" Appearance="Danger" Click="Exit_Click" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
