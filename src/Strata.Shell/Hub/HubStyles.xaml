<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Contenedor estándar de las páginas del Hub -->
    <Style x:Key="HubPageContent" TargetType="StackPanel">
        <Setter Property="Margin" Value="36,16,36,40" />
        <Setter Property="MaxWidth" Value="920" />
    </Style>

    <Style x:Key="HubPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Título de grupo de tarjetas: pequeño y con más aire arriba, como en Configuración de Windows -->
    <Style x:Key="HubSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,24,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="HubCard" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="MinHeight" Value="68" />
    </Style>

    <!-- Tarjeta que se despliega con las opciones que dependen de ella (subopciones) -->
    <Style x:Key="HubExpander" TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="18,6,18,10" />
    </Style>

    <!-- Una subopción dentro de una tarjeta desplegable: texto a la izquierda y control a la derecha,
         con sangría para que se lea como parte de la tarjeta de arriba -->
    <Style x:Key="HubSubOption" TargetType="Grid">
        <Setter Property="Margin" Value="40,6,0,6" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- Elemento de una barra en el editor de "Qué lleva cada barra" (se arrastra) -->
    <Style x:Key="BarChip" TargetType="Border">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="10,5,4,5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Mosaico de acceso rápido de la portada: ícono, título y descripción -->
    <Style x:Key="HubTile" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10" Padding="16,14" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pestaña de una entrada con varias páginas (Hub/TabbedPage): píldora, la elegida con el acento -->
    <Style x:Key="HubTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="16" Padding="14,7" BorderThickness="1"
                            Background="Transparent" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrataAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta del Dashboard (estado del equipo, accesos y acciones) -->
    <Style x:Key="DashCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- Opción de la esquina en el selector de posición de los avisos -->
    <Style x:Key="CornerOption" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="5" BorderThickness="1.5"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrataAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrataAccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrataAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
