<ui:FluentWindow x:Class="Strata.Shell.Hub.HubWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
                 xmlns:controls="clr-namespace:Strata.Shell.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Strata.Shell.Hub.Pages"
                 xmlns:hub="clr-namespace:Strata.Shell.Hub"
                 Title="Strata UI"
                 Icon="pack://application:,,,/Assets/strataui.ico"
                 Width="1040" Height="820" MinWidth="780" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
    <!-- Tinte del tema sobre el material de fondo (opaco en Material, sutil en los de vidrio) -->
    <Grid x:Name="Root" Background="{DynamicResource StrataHubTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="HubTitleBar" Grid.Row="0" Title="Strata UI">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{x:Static controls:Logo.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           OpenPaneLength="250">
            <!-- Buscador de páginas, pestañas, optimizaciones y widgets (Ctrl+F) -->
            <ui:NavigationView.PaneHeader>
                <hub:HubSearchBox x:Name="Search" />
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T 'Dashboard'}" TargetPageType="{x:Type pages:HomePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Board24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <!-- Las entradas con varias páginas las muestran en pestañas (Hub/TabbedPage) -->
                <ui:NavigationViewItem Content="{l:T 'Barra de tareas'}" TargetPageType="{x:Type hub:TaskbarHubPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PanelBottom20" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Paneles'}" TargetPageType="{x:Type pages:FlyoutsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PanelRight24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Menú Inicio'}" TargetPageType="{x:Type pages:StartPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Grid24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Notificaciones'}" TargetPageType="{x:Type pages:NotificationsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Alert24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Tema y colores'}" TargetPageType="{x:Type hub:AppearanceHubPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PaintBrush24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'Widgets'}" TargetPageType="{x:Type pages:WidgetsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Apps24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <!-- Módulos opcionales (arriba de Importar): la página para instalarlos y, dentro, las
                     páginas de los que traen las suyas (HubWindow.FillModules). -->
                <ui:NavigationViewItem x:Name="ModulesItem" Content="{l:T 'Módulos opcionales'}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <!-- Importar: temas, animaciones, widgets, menús de Inicio y sonidos -->
                <ui:NavigationViewItem Content="{l:T 'Importar'}" TargetPageType="{x:Type pages:ImportPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowImport24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T 'General'}" TargetPageType="{x:Type hub:SettingsHubPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
