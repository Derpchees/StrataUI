<UserControl x:Class="Strata.Shell.Controls.TaskButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Strata.Shell.Services.Localization">
    <Button x:Name="MainButton" Style="{StaticResource TaskbarButton}" Padding="0" ToolTip="{Binding Title}"
            Click="Button_Click">
        <Button.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="LaunchItem" Header="{l:T 'Abrir'}" Click="Launch_Click" FontWeight="SemiBold" />
                <MenuItem x:Name="PinItem" Header="{l:T 'Anclar a la barra de tareas'}" Click="TogglePin_Click" />
                <Separator x:Name="WindowSeparator" />
                <MenuItem x:Name="CloseItem" Header="{l:T 'Cerrar ventana'}" Click="CloseWindow_Click" />
                <MenuItem x:Name="ForceCloseItem" Header="{l:T 'Forzar cierre'}" Click="ForceClose_Click"
                          ToolTip="{l:T 'Termina la app sin esperar a que responda (se pierde lo que no se haya guardado)'}" />
            </ContextMenu>
        </Button.ContextMenu>
        <Grid x:Name="Root" Width="44">
            <!-- Varias ventanas agrupadas: el borde de otras "tarjetas" asoma detrás (una con 2 ventanas,
                 dos con 3 o más; ver UpdateGroup). Del color del texto de la barra, que contrasta con
                 ella en cualquier tema (y en la barra transparente sigue al fondo de cada botón). -->
            <Path x:Name="StackEdge2" Visibility="Collapsed" Fill="{DynamicResource StrataForegroundBrush}" />
            <Path x:Name="StackEdge" Visibility="Collapsed" Fill="{DynamicResource StrataForegroundBrush}" />
            <Border x:Name="ActiveBackground" CornerRadius="{DynamicResource StrataCornerRadius}" Background="{DynamicResource StrataActiveTaskBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Active">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Ícono de la app, o del sitio si es una pestaña de YouTube, WhatsApp Web… (ver TaskGroups) -->
            <Grid x:Name="IconHost" Width="24" Height="24">
                <Image x:Name="AppIcon" RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- El navegador en chiquito, en la esquina del ícono del sitio -->
                <Image x:Name="BrowserBadge" Width="11" Height="11" Margin="0,0,-3,-3" Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <!-- Indicador junto al borde de la pantalla (abajo en la barra inferior): corto = abierta, largo con acento = activa, ámbar = pide atención -->
            <Border x:Name="Indicator" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="{DynamicResource StrataInactiveIndicatorBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Active">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Background" Value="{DynamicResource StrataAccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Flashing">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Background" Value="#FFE8A33D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Button>
</UserControl>
