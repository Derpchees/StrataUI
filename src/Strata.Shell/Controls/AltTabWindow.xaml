<Window x:Class="Strata.Shell.Controls.AltTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
        Title="{l:T 'Cambiar de ventana'}"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <!-- Sin AllowsTransparency: las miniaturas de DWM no se dibujan en ventanas en capas. -->
    <Border x:Name="Card" Background="{DynamicResource StrataGlassPopupBrush}" Padding="14">
        <!-- Una tarjeta por ventana, en el orden de Alt+Tab; se arman por código -->
        <WrapPanel x:Name="Entries" Orientation="Horizontal" />
    </Border>
</Window>
