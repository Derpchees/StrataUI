<flyouts:FlyoutWindow x:Class="Strata.Shell.Flyouts.VolumeFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                      xmlns:flyouts="clr-namespace:Strata.Shell.Flyouts"
                      Title="{l:T 'Volumen'}" Width="372">
    <flyouts:FlyoutWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Dispositivo como mosaico cuadrado: clic para usarlo; "…" para sus opciones -->
        <DataTemplate x:Key="DeviceTile">
            <Grid Width="104" Height="112" Margin="0,0,8,8">
                <Button Click="Device_Click" ToolTip="{Binding ToolTip}" FocusVisualStyle="{x:Null}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="{DynamicResource StrataLargeCornerRadius}" BorderThickness="1.5"
                                    Background="{DynamicResource StrataSurfaceBrush}" BorderBrush="Transparent" Padding="8,10,8,8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrataAccentBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                        <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource StrataAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" MaxHeight="32" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Adapter}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlyoutIconButton}" Width="26" Height="26" Margin="0,6,6,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="DeviceOptions_Click"
                        ToolTip="{l:T 'Opciones del dispositivo'}" AutomationProperties.Name="Opciones del dispositivo">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Opciones de Windows del dispositivo elegido -->
        <DataTemplate x:Key="DeviceOptions">
            <Border CornerRadius="{DynamicResource StrataLargeCornerRadius}" Background="{DynamicResource StrataSurfaceBrush}"
                    Padding="14,10,10,12" Margin="0,0,8,8">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FlyoutText}" FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Adapter}" />
                        </StackPanel>
                        <Button Style="{StaticResource FlyoutIconButton}" Width="28" Height="28" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Click="CloseOptions_Click" ToolTip="{l:T 'Cerrar'}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Nivel en vivo (en micrófonos se abre una captura solo mientras esto está visible) -->
                    <TextBlock Style="{StaticResource FlyoutHint}" Margin="0,12,0,4" Text="{Binding LevelLabel}" />
                    <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Level, Mode=OneWay}" />

                    <StackPanel Visibility="{Binding BalanceVisibility}" Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'Balance'}" />
                            <TextBlock Style="{StaticResource FlyoutHint}" HorizontalAlignment="Right" Text="{Binding BalanceText}" />
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'I'}" />
                            <Slider Grid.Column="1" Margin="8,0" Minimum="-100" Maximum="100" TickFrequency="100" IsSnapToTickEnabled="False"
                                    TickPlacement="BottomRight" IsMoveToPointEnabled="True" Value="{Binding Balance, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource FlyoutHint}" Text="{l:T 'D'}" />
                        </Grid>
                    </StackPanel>

                    <!-- Escribirlas pide permiso de administrador (UAC); leerlas no -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding EnhancementsVisibility}">
                        <StackPanel Margin="0,0,56,0">
                            <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Mejoras de audio'}" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'Efectos del fabricante o de Windows: ecualizador, sonido envolvente, supresión de ruido…'}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Enhancements, Mode=TwoWay}" IsEnabled="{Binding NotBusy}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <StackPanel Margin="0,0,56,0">
                            <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Control exclusivo'}" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'Permite que una app (juegos, reproductores de audio) use el dispositivo sola.'}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ExclusiveAllowed, Mode=TwoWay}" IsEnabled="{Binding NotBusy}" />
                    </Grid>

                    <Grid Margin="0,12,0,0" Visibility="{Binding PriorityVisibility}">
                        <StackPanel Margin="0,0,56,0">
                            <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Prioridad a esa app'}" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'La app con control exclusivo no cede el dispositivo a otras.'}" />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ExclusivePriority, Mode=TwoWay}" IsEnabled="{Binding NotBusy}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:SymbolIcon Symbol="Shield24" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'Estas tres opciones piden permiso de administrador.'}" />
                    </StackPanel>

                    <Button Style="{StaticResource FlyoutRow}" Margin="-10,10,0,0" Click="Communications_Click"
                            IsEnabled="{Binding CanSetCommunications}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Call24" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding CommunicationsText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </flyouts:FlyoutWindow.Resources>

    <StackPanel Margin="14,8,6,10">
        <!-- ── Salida ── -->
        <TextBlock Style="{StaticResource FlyoutSection}" Margin="4,6,0,6" Text="{l:T 'Salida'}" />
        <Grid Margin="0,0,8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MasterMuteButton" Style="{StaticResource FlyoutIconButton}" Click="MasterMute_Click" ToolTip="{l:T 'Silenciar'}">
                <ui:SymbolIcon x:Name="MasterMuteIcon" Symbol="Speaker224" FontSize="18" />
            </Button>
            <Slider x:Name="MasterSlider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                    Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                    ValueChanged="MasterSlider_ValueChanged" />
            <TextBlock x:Name="MasterPercent" Grid.Column="2" Style="{StaticResource FlyoutPercent}" />
        </Grid>
        <!-- Dispositivos (plegados por defecto): la fila muestra el actual -->
        <Button x:Name="OutputHeader" Style="{StaticResource FlyoutRow}" Margin="0,1,8,1" Click="DevicesHeader_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="OutputDeviceIcon" Symbol="Speaker224" FontSize="16" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Dispositivo de salida'}" />
                    <TextBlock x:Name="OutputDeviceText" Style="{StaticResource FlyoutHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:SymbolIcon x:Name="OutputChevron" Grid.Column="2" Symbol="ChevronDown24" FontSize="14" RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </Grid>
        </Button>
        <StackPanel x:Name="OutputDevices" Margin="0,6,0,0" Visibility="Collapsed">
            <ItemsControl x:Name="OutputList" ItemTemplate="{StaticResource DeviceTile}" ItemsPanel="{StaticResource TilePanel}" />
            <ContentControl x:Name="OutputOptions" ContentTemplate="{StaticResource DeviceOptions}" Visibility="Collapsed" />
        </StackPanel>

        <!-- Sonar también en otra salida (los parlantes de los dos monitores a la vez) -->
        <Grid Margin="0,1,8,1">
            <Button x:Name="MirrorHeader" Style="{StaticResource FlyoutRow}" Click="MirrorHeader_Click">
                <Grid Margin="0,0,56,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="DesktopSpeaker24" FontSize="16" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Sonar también en'}" />
                        <TextBlock x:Name="MirrorText" Style="{StaticResource FlyoutHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
            <ui:ToggleSwitch x:Name="MirrorSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                             Click="MirrorSwitch_Click" />
        </Grid>
        <StackPanel x:Name="MirrorPanel" Margin="0,2,8,4" Visibility="Collapsed">
            <TextBlock x:Name="NoMirrorText" Style="{StaticResource FlyoutHint}" Margin="40,0,0,6" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="{l:T 'Conecta otra salida (un monitor con parlantes, unos audífonos…) para que suene en las dos.'}" />
            <ItemsControl x:Name="MirrorList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource FlyoutRow}" Click="MirrorDevice_Click">
                            <Grid Margin="28,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Adapter}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource StrataAccentBrush}"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Volumen de la segunda salida (el suyo en Windows) -->
            <Grid x:Name="MirrorVolumeRow" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Speaker124" FontSize="16" Margin="11,0,3,0" />
                <Slider x:Name="MirrorSlider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="100" IsMoveToPointEnabled="True" ValueChanged="MirrorSlider_ValueChanged" />
                <TextBlock x:Name="MirrorPercent" Grid.Column="2" Style="{StaticResource FlyoutPercent}" />
            </Grid>
        </StackPanel>

        <!-- ── Entrada ── -->
        <TextBlock Style="{StaticResource FlyoutSection}" Margin="4,10,0,6" Text="{l:T 'Entrada'}" />
        <Grid Margin="0,0,8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="InputMuteButton" Style="{StaticResource FlyoutIconButton}" Click="InputMute_Click" ToolTip="{l:T 'Silenciar micrófono'}">
                <ui:SymbolIcon x:Name="InputMuteIcon" Symbol="Mic24" FontSize="18" />
            </Button>
            <Slider x:Name="InputSlider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                    Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                    ValueChanged="InputSlider_ValueChanged" />
            <TextBlock x:Name="InputPercent" Grid.Column="2" Style="{StaticResource FlyoutPercent}" />
        </Grid>
        <!-- Dispositivos (plegados por defecto): la fila muestra el actual -->
        <Button x:Name="InputHeader" Style="{StaticResource FlyoutRow}" Margin="0,1,8,1" Click="DevicesHeader_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="InputDeviceIcon" Symbol="Mic24" FontSize="16" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Dispositivo de entrada'}" />
                    <TextBlock x:Name="InputDeviceText" Style="{StaticResource FlyoutHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:SymbolIcon x:Name="InputChevron" Grid.Column="2" Symbol="ChevronDown24" FontSize="14" RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </Grid>
        </Button>
        <StackPanel x:Name="InputDevices" Margin="0,6,0,0" Visibility="Collapsed">
            <ItemsControl x:Name="InputList" ItemTemplate="{StaticResource DeviceTile}" ItemsPanel="{StaticResource TilePanel}" />
            <TextBlock x:Name="NoInputText" Style="{StaticResource FlyoutHint}" Margin="4,0,0,8" Visibility="Collapsed"
                       Text="{l:T 'No hay micrófonos conectados.'}" />
            <ContentControl x:Name="InputOptions" ContentTemplate="{StaticResource DeviceOptions}" Visibility="Collapsed" />
        </StackPanel>

        <Separator Margin="0,6,8,4" Opacity="0.4" />

        <!-- ── Volumen por aplicación (plegable) ── -->
        <Button x:Name="AppsHeader" Style="{StaticResource FlyoutRow}" Margin="0,1,8,1" Click="AppsHeader_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Apps24" FontSize="16" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Aplicaciones'}" />
                    <TextBlock x:Name="AppsSummaryText" Style="{StaticResource FlyoutHint}" TextWrapping="NoWrap" />
                </StackPanel>
                <ui:SymbolIcon x:Name="AppsChevron" Grid.Column="2" Symbol="ChevronDown24" FontSize="14"
                               RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </Grid>
        </Button>
        <StackPanel x:Name="AppsPanel" Margin="4,4,8,0" Visibility="Collapsed">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Ícono de la app: clic para silenciarla -->
                            <Button Style="{StaticResource FlyoutIconButton}" Command="{Binding ToggleMute}"
                                    ToolTip="{Binding Name}">
                                <Grid>
                                    <Image Source="{Binding Icon}" Width="18" Height="18"
                                           RenderOptions.BitmapScalingMode="HighQuality" Opacity="{Binding IconOpacity}" />
                                    <ui:SymbolIcon Symbol="SpeakerMute24" FontSize="12" HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                                                   Visibility="{Binding MutedVisibility}" />
                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Visibility="{Binding FallbackIconVisibility}" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Name}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <Slider Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                        Value="{Binding Volume, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Style="{StaticResource FlyoutPercent}"
                                       Text="{Binding Volume, StringFormat={}{0:0}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoAppsText" Style="{StaticResource FlyoutHint}" Margin="4,0,0,4"
                       Text="{l:T 'Ninguna aplicación está usando el audio ahora.'}" Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</flyouts:FlyoutWindow>
