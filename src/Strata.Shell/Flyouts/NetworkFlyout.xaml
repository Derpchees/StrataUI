<flyouts:FlyoutWindow x:Class="Strata.Shell.Flyouts.NetworkFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                      xmlns:flyouts="clr-namespace:Strata.Shell.Flyouts"
                      xmlns:controls="clr-namespace:Strata.Shell.Controls"
                      Title="{l:T 'Red'}" Width="380">
    <!-- Arriba lo fijo; abajo la lista de redes, que se desplaza: con muchas redes cerca el panel no
         crece sin fin (su alto máximo va por la pantalla, NetworkFlyout.OnPropertyChanged). -->
    <Grid Margin="14,16,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
        <TextBlock Style="{StaticResource FlyoutTitle}" Margin="4,0,0,0" Text="{l:T 'Red'}" />

        <!-- Conexión actual: si es Wi-Fi, al tocarla muestra su contraseña y un QR (la red conectada no
             se repite en la lista de abajo). -->
        <Border Margin="0,12,0,0" CornerRadius="{DynamicResource StrataLargeCornerRadius}"
                Background="{DynamicResource StrataSurfaceBrush}">
            <StackPanel>
                <Button x:Name="ConnectionButton" Style="{StaticResource FlyoutRow}" Margin="0" Padding="12"
                        IsHitTestVisible="False" Click="Connection_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon x:Name="ConnectionIcon" Symbol="PlugConnected24" FontSize="22" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ConnectionName" Style="{StaticResource FlyoutText}" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConnectionStatus" Style="{StaticResource FlyoutHint}" />
                            <TextBlock x:Name="ConnectionAddress" Style="{StaticResource FlyoutHint}" />
                        </StackPanel>
                        <ui:SymbolIcon x:Name="ConnectionChevron" Grid.Column="2" Symbol="ChevronDown24" FontSize="14"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
                <!-- Red conectada: su contraseña guardada y un QR para unir otro dispositivo. Ocupa el lugar
                     de la lista de redes (MinHeight desde el código), así que el panel no cambia de alto. -->
                <Grid x:Name="CurrentPanel" Margin="12,0,12,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid MinHeight="216" Margin="0,4,0,12">
                        <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" Visibility="{Binding LoadingVisibility}" />
                        <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding KeyStatus}" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="260" Visibility="{Binding StatusVisibility}" />
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding KeyVisibility}">
                            <Border HorizontalAlignment="Center" Width="152" Height="152" Padding="9" CornerRadius="10"
                                    Background="White" ToolTip="{l:T 'Escanéalo con la cámara del teléfono para conectarte'}">
                                <Path Data="{Binding Qr}" Fill="Black" Stretch="Uniform" SnapsToDevicePixels="True" />
                            </Border>
                            <TextBlock Style="{StaticResource FlyoutHint}" Margin="0,8,0,10" HorizontalAlignment="Center"
                                       Text="{l:T 'Escanea para conectarte'}" />
                            <Border HorizontalAlignment="Center" MinWidth="200" MaxWidth="300" CornerRadius="6"
                                    Padding="10,2,2,2" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Key24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Style="{x:Null}" IsReadOnly="True" BorderThickness="0"
                                             Background="Transparent" Padding="0" VerticalAlignment="Center"
                                             FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                             Text="{Binding KeyText, Mode=OneWay}" />
                                    <Button Grid.Column="2" Style="{StaticResource FlyoutIconButton}" Margin="6,0,0,0"
                                            ToolTip="{l:T 'Copiar contraseña'}" Visibility="{Binding CopyVisibility}"
                                            Click="CopyKey_Click">
                                        <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FlyoutHint}" VerticalAlignment="Center" Margin="2,0,8,0"
                                       Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                            <ui:Button Grid.Column="1" MinWidth="110" Content="{Binding ActionText}"
                                       Click="NetworkAction_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Wi-Fi -->
        <Grid x:Name="WifiHeader" Margin="0,16,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FlyoutSection}" Margin="4,0,0,0" VerticalAlignment="Center" Text="WI-FI" />
            <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource FlyoutIconButton}" ToolTip="{l:T 'Buscar redes'}"
                    Click="Scan_Click">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
            </Button>
            <ui:ToggleSwitch x:Name="WifiSwitch" Grid.Column="2" Margin="8,0,0,0" Click="WifiSwitch_Click" />
        </Grid>


        </StackPanel>

        <!-- Alto fijo (con o sin redes, buscando o no): el panel no cambia de tamaño. -->
        <Grid x:Name="NetworkArea" Grid.Row="1" Height="270">
        <TextBlock x:Name="WifiHint" Style="{StaticResource FlyoutHint}" Margin="4,0,0,6" VerticalAlignment="Top"
                   Visibility="Collapsed" />
        <ui:ProgressRing x:Name="ScanProgress" IsIndeterminate="True" Width="28" Height="28"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <ScrollViewer x:Name="NetworkScroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="0,0,-8,0" Padding="0,0,8,0">
        <ItemsControl x:Name="NetworkList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Button Style="{StaticResource FlyoutRow}" Click="Network_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding SignalSymbol}" FontSize="18" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding Ssid}" />
                                    <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Detail}" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="LockClosed24" FontSize="14"
                                               Visibility="{Binding LockVisibility}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <!-- Panel de conexión al seleccionar una red -->
                        <StackPanel Margin="40,2,10,10" Visibility="{Binding ExpandedVisibility}">
                            <!-- Puntos, el último carácter un momento y un ojo para verla (Controls/RevealPasswordBox) -->
                            <controls:RevealPasswordBox Margin="0,0,0,8" Visibility="{Binding PasswordVisibility}"
                                                        Loaded="PasswordBox_Loaded" KeyDown="PasswordBox_KeyDown" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Margin="0,0,0,8" Text="{Binding Message}"
                                       TextWrapping="Wrap" Visibility="{Binding MessageVisibility}" />
                            <ui:Button HorizontalAlignment="Right" Appearance="Primary" MinWidth="110"
                                       Content="{Binding ActionText}" Click="NetworkAction_Click" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
        </Grid>
    </Grid>
</flyouts:FlyoutWindow>
