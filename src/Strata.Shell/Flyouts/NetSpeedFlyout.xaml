<flyouts:FlyoutWindow x:Class="Strata.Shell.Flyouts.NetSpeedFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                      xmlns:flyouts="clr-namespace:Strata.Shell.Flyouts"
                      Title="{l:T 'Velocidad de internet'}" Width="360">
    <StackPanel Margin="14,16,14,14">
        <TextBlock Style="{StaticResource FlyoutTitle}" Margin="4,0,0,4" Text="{l:T 'Velocidad de internet'}" />

        <!-- Ahora mismo (lo del medidor de la barra) -->
        <TextBlock x:Name="LiveText" Style="{StaticResource FlyoutHint}" Margin="4,0,0,12" />

        <!-- Prueba de velocidad -->
        <Border Padding="14,12" CornerRadius="{DynamicResource StrataLargeCornerRadius}" Background="{DynamicResource StrataSurfaceBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'Bajada'}" />
                        </StackPanel>
                        <TextBlock x:Name="DownText" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource StrataForegroundBrush}" Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'Subida'}" />
                        </StackPanel>
                        <TextBlock x:Name="UpText" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource StrataForegroundBrush}" Text="—" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="PingText" Style="{StaticResource FlyoutText}" Margin="0,8,0,0" />
                <ProgressBar x:Name="TestProgress" Margin="0,10,0,0" Height="4" Minimum="0" Maximum="1" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Style="{StaticResource FlyoutHint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <ui:Button x:Name="TestButton" Margin="0,12,0,0" HorizontalAlignment="Stretch" Appearance="Primary"
                           Icon="{ui:SymbolIcon TopSpeed20}" Click="Test_Click" />
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource FlyoutHint}" Margin="4,8,8,0" TextWrapping="Wrap"
                   Text="{l:T 'Con los servidores de Cloudflare. Usa datos: en una conexión rápida, unos cientos de MB.'}" />

        <Button Style="{StaticResource FlyoutRow}" Margin="0,8,0,0" Click="TaskManager_Click">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DataUsage20" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Administrador de tareas'}" />
            </StackPanel>
        </Button>
    </StackPanel>
</flyouts:FlyoutWindow>
