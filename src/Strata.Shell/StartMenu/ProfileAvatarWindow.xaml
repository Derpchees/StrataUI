<Window x:Class="Strata.Shell.StartMenu.ProfileAvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="140" Height="140" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStartupLocation="Manual" IsHitTestVisible="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- Foto con anillo de acento; la ventana deja margen para la sombra. -->
    <Grid Width="104" Height="104">
        <Ellipse>
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource SystemAccentColorSecondary}" Offset="0" />
                    <GradientStop Color="{DynamicResource SystemAccentColorTertiary}" Offset="1" />
                </LinearGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
            </Ellipse.Effect>
        </Ellipse>
        <Grid Width="94" Height="94">
            <Ellipse Fill="{DynamicResource StrataAccentBrush}" />
            <TextBlock Text="{Binding UserInitials}" FontSize="34" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Ellipse Visibility="{Binding HasUserPicture, Converter={StaticResource BoolToVis}}">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding UserPicture}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </Grid>
</Window>
