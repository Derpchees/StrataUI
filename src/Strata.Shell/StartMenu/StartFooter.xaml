<UserControl x:Class="Strata.Shell.StartMenu.StartFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:start="clr-namespace:Strata.Shell.StartMenu">
    <UserControl.Resources>
        <ContextMenu x:Key="PowerMenu" Placement="Top">
            <MenuItem Header="{l:T 'Bloquear'}" Command="{x:Static start:StartCommands.Power}" CommandParameter="Lock">
                <MenuItem.Icon><ui:SymbolIcon Symbol="LockClosed24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Cerrar sesión'}" Command="{x:Static start:StartCommands.Power}" CommandParameter="SignOut">
                <MenuItem.Icon><ui:SymbolIcon Symbol="SignOut24" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:T 'Suspender'}" Command="{x:Static start:StartCommands.Power}" CommandParameter="Sleep">
                <MenuItem.Icon><ui:SymbolIcon Symbol="WeatherMoon24" /></MenuItem.Icon>
            </MenuItem>
            <!-- Solo con actualizaciones esperando un reinicio (StartFooter.FooterButton_Click) -->
            <MenuItem Header="{l:T 'Actualizar y reiniciar'}" Command="{x:Static start:StartCommands.Power}" CommandParameter="UpdateRestart">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Reiniciar'}" Command="{x:Static start:StartCommands.Power}" CommandParameter="Restart">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Actualizar y apagar'}" Command="{x:Static start:StartCommands.Power}" CommandParameter="UpdatePowerOff">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Apagar'}" Command="{x:Static start:StartCommands.Power}" CommandParameter="PowerOff">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Power24" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <!-- Pie del menú: usuario (opcional) a la izquierda y los botones elegidos en el Hub a la derecha -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button x:Name="UserBadge" Style="{StaticResource FlyoutRow}" HorizontalAlignment="Left" Padding="8,6"
                Visibility="{Binding ShowUser, Converter={StaticResource BoolToVis}}"
                Command="{x:Static start:StartCommands.OpenFolder}" CommandParameter="User"
                ToolTip="{l:T 'Abrir tu carpeta de usuario'}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="32" Height="32" Margin="0,0,10,0">
                    <Ellipse Fill="{DynamicResource StrataAccentBrush}" />
                    <TextBlock Text="{Binding UserInitials}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <!-- Foto de la cuenta, recortada en círculo, encima de las iniciales -->
                    <Ellipse Visibility="{Binding HasUserPicture, Converter={StaticResource BoolToVis}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding UserPicture}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding UserName}" />
            </StackPanel>
        </Button>

        <ItemsControl Grid.Column="1" ItemsSource="{Binding FooterButtons}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource FlyoutIconButton}" Width="40" Height="40" Margin="2,0,0,0"
                            ToolTip="{Binding Label}" Click="FooterButton_Click">
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</UserControl>
