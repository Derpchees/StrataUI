<UserControl x:Class="Strata.Shell.StartMenu.PinnedLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:svc="clr-namespace:Strata.Shell.Services.StartMenu"
             xmlns:start="clr-namespace:Strata.Shell.StartMenu">
    <UserControl.Resources>
        <!-- App anclada: se abre con clic, se arrastra para mover o para crear una carpeta -->
        <DataTemplate DataType="{x:Type svc:StartApp}">
            <Button Style="{StaticResource FlyoutRow}" Width="{DynamicResource StartTileWidth}" Padding="4,10,4,8"
                    HorizontalContentAlignment="Center" ToolTip="{Binding Name}"
                    Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseDown" PreviewMouseMove="Tile_PreviewMouseMove"
                    RenderTransformOrigin="0.5,0.5">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T 'Abrir'}" Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}" FontWeight="SemiBold" />
                        <MenuItem Header="{l:T 'Ejecutar como administrador'}" Command="{x:Static start:StartCommands.RunAsAdmin}" CommandParameter="{Binding}"
                                  Visibility="{Binding CanRunAsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="{l:T 'Abrir ubicación del archivo'}" Command="{x:Static start:StartCommands.OpenLocation}" CommandParameter="{Binding}"
                                  Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVis}}" />
                        <Separator />
                        <MenuItem Header="{l:T 'Cambiar ícono…'}" Command="{x:Static start:StartCommands.ChangeIcon}" CommandParameter="{Binding}" />
                        <MenuItem Header="{l:T 'Restaurar ícono'}" Command="{x:Static start:StartCommands.ResetIcon}" CommandParameter="{Binding}"
                                  Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}" />
                        <Separator />
                        <MenuItem Header="{l:T 'Desanclar de Inicio'}" Command="{x:Static start:StartCommands.TogglePin}" CommandParameter="{Binding}" />
                        <MenuItem Header="{l:T 'Desinstalar'}" Command="{x:Static start:StartCommands.Uninstall}" CommandParameter="{Binding}"
                                  Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}"
                           Margin="{DynamicResource StartTileIconMargin}" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" FontSize="12" Visibility="{DynamicResource StartTileLabelVisibility}" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Carpeta: miniatura 2×2 de sus apps; clic para abrirla -->
        <DataTemplate DataType="{x:Type svc:PinFolderView}">
            <Button Style="{StaticResource FlyoutRow}" Width="{DynamicResource StartTileWidth}" Padding="4,10,4,8"
                    HorizontalContentAlignment="Center" ToolTip="{Binding Name}"
                    Click="Folder_Click"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseDown" PreviewMouseMove="Tile_PreviewMouseMove"
                    RenderTransformOrigin="0.5,0.5">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T 'Abrir carpeta'}" Click="FolderOpen_Click" />
                        <MenuItem Header="{l:T 'Desagrupar'}" Click="FolderUngroup_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Border Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}" Margin="{DynamicResource StartTileIconMargin}"
                            CornerRadius="{DynamicResource StrataCornerRadius}" Background="{DynamicResource StrataSurfaceBrush}" Padding="3">
                        <ItemsControl ItemsSource="{Binding Preview}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding}" Margin="1" RenderOptions.BitmapScalingMode="HighQuality" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12" Visibility="{DynamicResource StartTileLabelVisibility}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Celda vacía que deja la colocación libre: invisible, del mismo tamaño que un mosaico.
             Soltar algo encima lo coloca ahí. -->
        <DataTemplate DataType="{x:Type svc:PinGapView}">
            <Button Width="{DynamicResource StartTileWidth}" Padding="4,10,4,8" Focusable="False"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseDown" PreviewMouseMove="Tile_PreviewMouseMove"
                    RenderTransformOrigin="0.5,0.5">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <!-- Mismo alto que un mosaico: ícono y nombre invisibles -->
                <StackPanel Opacity="0">
                    <Border Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}" Margin="{DynamicResource StartTileIconMargin}" />
                    <TextBlock Text=" " FontSize="12" Visibility="{DynamicResource StartTileLabelVisibility}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Clic derecho en un lugar vacío: nueva sección o anclar archivos y carpetas -->
    <Grid Background="Transparent">
    <Grid.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{l:T 'Nueva sección'}" Click="NewSection_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Add24" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:T 'Anclar archivo o acceso directo…'}" Command="{x:Static start:StartCommands.PinFile}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Document24" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:T 'Anclar carpeta…'}" Command="{x:Static start:StartCommands.PinFolder}">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Folder24" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Grid.ContextMenu>
    <StackPanel>
        <ItemsControl ItemsSource="{x:Static svc:PinLayout.Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <!-- Encabezado: doble clic o clic derecho para renombrar -->
                        <Grid Margin="8,0,8,4" Background="Transparent" MouseLeftButtonDown="SectionHeader_MouseDown">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T 'Renombrar sección'}" Click="SectionRename_Click" />
                                    <MenuItem Header="{l:T 'Nueva sección debajo'}" Click="SectionAdd_Click" />
                                    <Separator />
                                    <MenuItem Header="{l:T 'Eliminar sección'}" Click="SectionDelete_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <TextBlock Style="{StaticResource StartSectionTitle}" Text="{Binding Name}" />
                            <TextBox Visibility="Collapsed" Text="{Binding Name, Mode=OneTime}" MinWidth="160" HorizontalAlignment="Left"
                                     KeyDown="SectionEditor_KeyDown" LostFocus="SectionEditor_LostFocus" />
                        </Grid>
                        <!-- Cuadrícula de la sección: soltar en una celda vacía deja el elemento ahí -->
                        <ItemsControl ItemsSource="{Binding Tiles}" ItemsPanel="{StaticResource WrapItems}" MinHeight="44"
                                      Background="Transparent" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ícono que sigue al cursor mientras se arrastra -->
        <Popup x:Name="DragGhost" AllowsTransparency="True" Placement="Relative" IsHitTestVisible="False">
            <Border Padding="8" CornerRadius="{DynamicResource StrataCornerRadius}" Background="{DynamicResource StrataSurfaceBrush}" Opacity="0.9">
                <Image x:Name="DragGhostIcon" Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </Popup>

        <!-- Contenido de una carpeta abierta -->
        <Popup x:Name="FolderPopup" StaysOpen="False" AllowsTransparency="True" Placement="Center" PopupAnimation="Fade">
            <Border Width="360" Padding="16" CornerRadius="{DynamicResource StrataLargeCornerRadius}"
                    Background="{DynamicResource StrataPopupBackgroundBrush}"
                    BorderBrush="{DynamicResource StrataFlyoutBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBox x:Name="FolderName" FontSize="15" Margin="0,0,0,12" KeyDown="FolderName_KeyDown" LostFocus="FolderName_LostFocus" />
                    <ItemsControl x:Name="FolderApps" ItemsPanel="{StaticResource WrapItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FlyoutRow}" Width="{DynamicResource StartTileWidth}" Padding="4,10,4,8"
                                        HorizontalContentAlignment="Center" ToolTip="{Binding Name}"
                                        Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                                        PreviewMouseLeftButtonDown="Tile_PreviewMouseDown" PreviewMouseMove="FolderApp_PreviewMouseMove">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:T 'Sacar de la carpeta'}" Click="FolderTakeOut_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <Image Source="{Binding Icon}" Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}"
                                               Margin="0,0,0,6" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FlyoutHint}" Margin="4,8,0,0"
                               Text="{l:T 'Arrastra una app fuera de la carpeta para sacarla.'}" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>

    <!-- Al arrastrar: contorno de la celda vacía donde caería el elemento -->
    <Canvas IsHitTestVisible="False">
        <Border x:Name="CellHint" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="1.5" CornerRadius="{DynamicResource StrataCornerRadius}"
                BorderBrush="{DynamicResource StrataAccentBrush}" Background="{DynamicResource StrataSurfaceBrush}" Opacity="0.8" />
    </Canvas>
    </Grid>
</UserControl>

