<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Strata.Shell.Services.Localization"
                    xmlns:start="clr-namespace:Strata.Shell.StartMenu">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="StartSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Menú contextual común a cualquier app: abrir, anclar, ubicación, administrador, desinstalar -->
    <ContextMenu x:Key="AppContextMenu" x:Shared="False">
        <MenuItem Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}" Header="{l:T 'Abrir'}" FontWeight="SemiBold" />
        <MenuItem Command="{x:Static start:StartCommands.OpenPrivateWindow}" CommandParameter="{Binding}" Header="{Binding PrivateWindowLabel}"
                  Visibility="{Binding CanOpenPrivateWindow, Converter={StaticResource BoolToVis}}" />
        <MenuItem Command="{x:Static start:StartCommands.RunAsAdmin}" CommandParameter="{Binding}" Header="{l:T 'Ejecutar como administrador'}"
                  Visibility="{Binding CanRunAsAdmin, Converter={StaticResource BoolToVis}}" />
        <MenuItem Command="{x:Static start:StartCommands.OpenLocation}" CommandParameter="{Binding}" Header="{l:T 'Abrir ubicación del archivo'}"
                  Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVis}}" />
        <Separator />
        <MenuItem Command="{x:Static start:StartCommands.TogglePin}" CommandParameter="{Binding}">
            <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{l:T 'Anclar a Inicio'}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter Property="Header" Value="{l:T 'Desanclar de Inicio'}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </MenuItem.Style>
        </MenuItem>
        <MenuItem Command="{x:Static start:StartCommands.ToggleTaskbarPin}" CommandParameter="{Binding}">
            <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{l:T 'Anclar a la barra de tareas'}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPinnedToTaskbar}" Value="True">
                            <Setter Property="Header" Value="{l:T 'Desanclar de la barra de tareas'}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </MenuItem.Style>
        </MenuItem>
        <MenuItem Command="{x:Static start:StartCommands.ChangeIcon}" CommandParameter="{Binding}" Header="{l:T 'Cambiar ícono…'}" />
        <MenuItem Command="{x:Static start:StartCommands.ResetIcon}" CommandParameter="{Binding}" Header="{l:T 'Restaurar ícono'}"
                  Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVis}}" />
        <MenuItem Command="{x:Static start:StartCommands.Uninstall}" CommandParameter="{Binding}" Header="{l:T 'Desinstalar'}"
                  Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
    </ContextMenu>

    <!-- App en cuadrícula: ícono grande y nombre debajo -->
    <DataTemplate x:Key="AppTile">
        <Button Style="{StaticResource FlyoutRow}" Width="{DynamicResource StartTileWidth}" Padding="4,10,4,8" HorizontalContentAlignment="Center"
                Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                ToolTip="{Binding Name}" ContextMenu="{StaticResource AppContextMenu}">
            <StackPanel>
                <Image Source="{Binding Icon}" Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}" Margin="{DynamicResource StartTileIconMargin}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Name}" FontSize="12" Visibility="{DynamicResource StartTileLabelVisibility}" TextAlignment="Center" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="32" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- App grande para pantalla completa -->
    <DataTemplate x:Key="AppTileLarge">
        <Button Style="{StaticResource FlyoutRow}" Width="{DynamicResource StartLargeTileWidth}" Padding="6,14,6,10" HorizontalContentAlignment="Center"
                Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                ToolTip="{Binding Name}" ContextMenu="{StaticResource AppContextMenu}">
            <StackPanel>
                <Image Source="{Binding Icon}" Width="{DynamicResource StartLargeIconSize}" Height="{DynamicResource StartLargeIconSize}" Margin="0,0,0,8"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="36" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- App en lista: ícono y nombre en una fila -->
    <DataTemplate x:Key="AppRow">
        <Button Style="{StaticResource FlyoutRow}" Padding="10,6"
                Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                ContextMenu="{StaticResource AppContextMenu}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="{DynamicResource StartRowIconSize}" Height="{DynamicResource StartRowIconSize}" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding Name}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Resultado de la búsqueda: ícono, nombre y qué es; el elegido (Enter, flechas) queda resaltado -->
    <DataTemplate x:Key="SearchRow">
        <Button Padding="10,6" Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                ContextMenu="{StaticResource AppContextMenu}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource FlyoutRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="{DynamicResource StartRowIconSize}" Height="{DynamicResource StartRowIconSize}" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource FlyoutHint}" FontSize="11" Text="{Binding Kind}" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- Panel de detalles del resultado elegido (como en Windows): qué es y sus acciones -->
    <DataTemplate x:Key="SearchDetails">
        <StackPanel Margin="8,0,0,0">
            <Image Source="{Binding Icon}" Width="56" Height="56" Margin="0,16,0,10" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Kind}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Id}" FontSize="11" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" />
            <Separator Margin="0,12,0,6" />
            <Button Style="{StaticResource FlyoutRow}" Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}">
                <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Abrir'}" />
            </Button>
            <Button Style="{StaticResource FlyoutRow}" Command="{x:Static start:StartCommands.OpenPrivateWindow}" CommandParameter="{Binding}"
                    Visibility="{Binding CanOpenPrivateWindow, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding PrivateWindowLabel}" />
            </Button>
            <Button Style="{StaticResource FlyoutRow}" Command="{x:Static start:StartCommands.RunAsAdmin}" CommandParameter="{Binding}"
                    Visibility="{Binding CanRunAsAdmin, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Ejecutar como administrador'}" />
            </Button>
            <Button Style="{StaticResource FlyoutRow}" Command="{x:Static start:StartCommands.OpenLocation}" CommandParameter="{Binding}"
                    Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Abrir ubicación del archivo'}" />
            </Button>
            <Button Style="{StaticResource FlyoutRow}" Command="{x:Static start:StartCommands.TogglePin}" CommandParameter="{Binding}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FlyoutText}">
                            <Setter Property="Text" Value="{l:T 'Anclar a Inicio'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Text" Value="{l:T 'Desanclar de Inicio'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource FlyoutRow}" Command="{x:Static start:StartCommands.ToggleTaskbarPin}" CommandParameter="{Binding}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FlyoutText}">
                            <Setter Property="Text" Value="{l:T 'Anclar a la barra de tareas'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinnedToTaskbar}" Value="True">
                                    <Setter Property="Text" Value="{l:T 'Desanclar de la barra de tareas'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource FlyoutRow}" Command="{x:Static start:StartCommands.Uninstall}" CommandParameter="{Binding}"
                    Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource FlyoutText}" Text="{l:T 'Desinstalar'}" />
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- Archivo reciente -->
    <DataTemplate x:Key="RecentRow">
        <Button Style="{StaticResource FlyoutRow}" Padding="10,6"
                Command="{x:Static start:StartCommands.OpenRecent}" CommandParameter="{Binding}" ToolTip="{Binding Path}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding WhenText}" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- Encabezado de letra en "Todas las apps" -->
    <GroupStyle x:Key="LetterGroups">
        <GroupStyle.HeaderTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}" Margin="10,10,0,4" FontWeight="SemiBold"
                           Foreground="{DynamicResource StrataAccentBrush}" />
            </DataTemplate>
        </GroupStyle.HeaderTemplate>
    </GroupStyle>

    <!-- "Todas las apps": solo se arman las filas que se ven (con cientos de apps abrirla trababa el menú) -->
    <Style x:Key="VirtualAppList" TargetType="ItemsControl">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        <Setter Property="VirtualizingPanel.CacheLength" Value="1" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ItemsPanelTemplate x:Key="WrapItems">
        <WrapPanel />
    </ItemsPanelTemplate>
</ResourceDictionary>
