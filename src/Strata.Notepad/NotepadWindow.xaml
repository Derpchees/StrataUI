<ui:FluentWindow x:Class="Strata.Shell.Notepad.NotepadWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:l="clr-namespace:Strata.Shell.Services.Localization;assembly=StrataUI"
                 xmlns:controls="clr-namespace:Strata.Shell.Controls;assembly=StrataUI"
                 xmlns:notepad="clr-namespace:Strata.Shell.Notepad"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{l:T 'Bloc de notas'}"
                 Icon="{x:Static notepad:NotepadIcon.Bitmap}"
                 Width="980" Height="680" MinWidth="460" MinHeight="300"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 AllowDrop="True">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="NotepadStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="TabTemplate">
                <Border x:Name="Tab" Height="32" MinWidth="110" MaxWidth="220" Margin="0,0,4,0" Padding="12,0,4,0" CornerRadius="8"
                        Background="Transparent" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                        MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseDown="Tab_MouseDown" ToolTip="{Binding ToolTip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Grid Grid.Column="1" Width="22" Height="22" Margin="6,0,0,0">
                            <!-- Sin guardar: un punto en lugar de la X (la X vuelve al pasar el ratón) -->
                            <Ellipse x:Name="Dirty" Width="8" Height="8" Fill="{DynamicResource StrataAccentBrush}"
                                     IsHitTestVisible="False" Visibility="Collapsed" />
                            <Button x:Name="CloseButton" Style="{StaticResource ToolButton}" Width="22" Height="22"
                                    Click="CloseTab_Click" ToolTip="{l:T 'Cerrar pestaña (Ctrl+W)'}">
                                <ui:SymbolIcon Symbol="Dismiss12" FontSize="10" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Tab" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter TargetName="Tab" Property="BorderThickness" Value="1" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsDirty}" Value="True" />
                            <Condition Binding="{Binding IsMouseOver, ElementName=Tab}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Dirty" Property="Visibility" Value="Visible" />
                        <Setter TargetName="CloseButton" Property="Visibility" Value="Hidden" />
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid x:Name="Root" Background="{DynamicResource StrataHubTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título con las pestañas -->
        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="{l:T 'Bloc de notas'}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{x:Static notepad:NotepadIcon.Image}" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4,0,0">
                    <ItemsControl x:Name="TabStrip" ItemTemplate="{StaticResource TabTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Click="New_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T 'Nueva pestaña (Ctrl+N)'}">
                        <ui:SymbolIcon Symbol="Add16" FontSize="14" />
                    </Button>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Barra de comandos -->
        <DockPanel Grid.Row="1" Margin="10,2,10,6" LastChildFill="False">
            <Button Style="{StaticResource ToolButton}" Click="Open_Click" ToolTip="{l:T 'Abrir (Ctrl+O)'}">
                <ui:SymbolIcon Symbol="FolderOpen20" FontSize="17" />
            </Button>
            <Button Style="{StaticResource ToolButton}" Click="Save_Click" ToolTip="{l:T 'Guardar (Ctrl+S)'}">
                <ui:SymbolIcon Symbol="Save20" FontSize="17" />
            </Button>
            <Button Style="{StaticResource ToolButton}" Click="SaveAs_Click" ToolTip="{l:T 'Guardar como (Ctrl+Mayús+S)'}">
                <ui:SymbolIcon Symbol="SaveEdit20" FontSize="17" />
            </Button>
            <Rectangle Width="1" Height="18" Margin="6,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Click="Undo_Click" ToolTip="{l:T 'Deshacer (Ctrl+Z)'}">
                <ui:SymbolIcon Symbol="ArrowUndo20" FontSize="17" />
            </Button>
            <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Click="Redo_Click" ToolTip="{l:T 'Rehacer (Ctrl+Y)'}">
                <ui:SymbolIcon Symbol="ArrowRedo20" FontSize="17" />
            </Button>
            <Rectangle Width="1" Height="18" Margin="6,0" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <ToggleButton x:Name="FindToggle" Style="{StaticResource ToolToggle}" Click="FindToggle_Click" ToolTip="{l:T 'Buscar y reemplazar (Ctrl+F)'}">
                <ui:SymbolIcon Symbol="Search20" FontSize="17" />
            </ToggleButton>
            <Button Style="{StaticResource ToolButton}" Click="GoTo_Click" ToolTip="{l:T 'Ir a la línea (Ctrl+G)'}">
                <ui:SymbolIcon Symbol="ArrowRight20" FontSize="17" />
            </Button>
            <ToggleButton x:Name="WrapToggle" Style="{StaticResource ToolToggle}" Click="WrapToggle_Click" ToolTip="{l:T 'Ajuste de línea (Alt+Z)'}">
                <ui:SymbolIcon Symbol="TextWrap20" FontSize="17" />
            </ToggleButton>

            <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="More_Click" ToolTip="{l:T 'Más opciones'}">
                <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="17" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="ZoomIn_Click" ToolTip="{l:T 'Acercar (Ctrl+más)'}">
                <ui:SymbolIcon Symbol="ZoomIn20" FontSize="17" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="ZoomOut_Click" ToolTip="{l:T 'Alejar (Ctrl+menos)'}">
                <ui:SymbolIcon Symbol="ZoomOut20" FontSize="17" />
            </Button>
        </DockPanel>

        <!-- Buscar y reemplazar -->
        <Border x:Name="FindBar" Grid.Row="2" Visibility="Collapsed" Margin="12,0,12,8" Padding="8" CornerRadius="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FindText" Style="{StaticResource FindBox}" Tag="{l:T 'Buscar'}"
                         TextChanged="FindText_TextChanged" PreviewKeyDown="FindText_PreviewKeyDown" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MatchInfo" MinWidth="64" Margin="4,0,6,0" FontSize="12" VerticalAlignment="Center"
                               TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Click="FindPrevious_Click" ToolTip="{l:T 'Anterior (Mayús+F3)'}">
                        <ui:SymbolIcon Symbol="ArrowUp16" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Click="FindNext_Click" ToolTip="{l:T 'Siguiente (F3)'}">
                        <ui:SymbolIcon Symbol="ArrowDown16" FontSize="14" />
                    </Button>
                    <ToggleButton x:Name="MatchCase" Style="{StaticResource OptionToggle}" Content="Aa" Click="FindOption_Click"
                                  ToolTip="{l:T 'Distinguir mayúsculas y minúsculas'}" />
                    <ToggleButton x:Name="WholeWord" Style="{StaticResource OptionToggle}" Click="FindOption_Click"
                                  ToolTip="{l:T 'Solo palabras completas'}">
                        <ui:SymbolIcon Symbol="TextWholeWord20" FontSize="15" />
                    </ToggleButton>
                </StackPanel>
                <TextBox x:Name="ReplaceText" Grid.Column="2" Style="{StaticResource FindBox}" Tag="{l:T 'Reemplazar con'}"
                         PreviewKeyDown="ReplaceText_PreviewKeyDown" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Style="{StaticResource TextButton}" Content="{l:T 'Reemplazar'}" Click="Replace_Click" />
                    <Button Style="{StaticResource TextButton}" Content="{l:T 'Todo'}" Click="ReplaceAll_Click"
                            ToolTip="{l:T 'Reemplazar todo'}" />
                    <Button Style="{StaticResource ToolButton}" Width="30" Height="30" Margin="4,0,0,0" Click="CloseFind_Click"
                            ToolTip="{l:T 'Cerrar (Esc)'}">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- El texto: cada pestaña tiene su cuadro (y su historial de deshacer) -->
        <Border Grid.Row="3" Margin="12,0,12,0" CornerRadius="10" ClipToBounds="True"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <ContentControl x:Name="EditorHost" Focusable="False" />
                <TextBlock x:Name="ZoomBadge" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,8"
                           FontSize="20" FontWeight="SemiBold" Visibility="Collapsed" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Background="{DynamicResource StrataPanelBackgroundBrush}" />
            </Grid>
        </Border>

        <!-- Barra de estado -->
        <DockPanel x:Name="StatusBar" Grid.Row="4" Margin="14,4,14,6" LastChildFill="False">
            <Button x:Name="CaretInfo" Style="{StaticResource StatusButton}" Click="GoTo_Click" ToolTip="{l:T 'Ir a la línea (Ctrl+G)'}" />
            <TextBlock x:Name="CountInfo" Margin="8,0" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button x:Name="EncodingButton" DockPanel.Dock="Right" Style="{StaticResource StatusButton}" Click="Encoding_Click"
                    ToolTip="{l:T 'Codificación al guardar'}" />
            <Button x:Name="LineEndingButton" DockPanel.Dock="Right" Style="{StaticResource StatusButton}" Click="LineEnding_Click"
                    ToolTip="{l:T 'Saltos de línea al guardar'}" />
            <Button x:Name="ZoomInfo" DockPanel.Dock="Right" Style="{StaticResource StatusButton}" Click="ZoomReset_Click"
                    ToolTip="{l:T 'Restablecer zoom (Ctrl+0)'}" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
