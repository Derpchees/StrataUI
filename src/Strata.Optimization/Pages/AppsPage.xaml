<Page x:Class="Strata.Shell.Hub.Pages.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Strata.Shell.Services.Localization;assembly=StrataUI"
      xmlns:hub="clr-namespace:Strata.Shell.Hub;assembly=StrataUI"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Apps preinstaladas'}"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,8,32,24" MaxWidth="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <hub:PageHeader Icon="Delete24" Title="{l:T 'Apps preinstaladas'}" Subtitle="{l:T 'Quita las apps que vienen con Windows y no usas. Las marcadas como recomendadas son publicidad o servicios que casi nadie usa. Todas se pueden reinstalar desde Microsoft Store.'}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{l:T 'Marcar recomendadas'}" Margin="0,0,8,0" Click="SelectRecommended_Click" />
                <ui:Button Content="{l:T 'Desmarcar todo'}" Margin="0,0,8,0" Click="SelectNone_Click" />
                <ui:Button Click="Refresh_Click" ToolTip="{l:T 'Actualizar lista'}">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button>
            </StackPanel>
            <CheckBox x:Name="ShowAllBox" Grid.Column="1" Content="{l:T 'Mostrar todas las apps'}" Click="ShowAll_Click" />
        </Grid>

        <Border Grid.Row="2" CornerRadius="8" Padding="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                    <ItemsControl x:Name="AppList" Margin="8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4" Click="Selection_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Package.Label}" />
                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding RecommendedVisibility}">
                                            <TextBlock FontSize="11" Text="{l:T 'Recomendada'}"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource CardDescription}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" Text="{Binding Package.Name}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ui:ProgressRing x:Name="Loading" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="AllUsersBox" Content="{l:T 'Quitar también para otros usuarios y cuentas nuevas (requiere administrador)'}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CardDescription}" Margin="0,4,0,0" />
            </StackPanel>
            <ui:Button x:Name="RemoveButton" Grid.Column="1" Appearance="Danger" Click="Remove_Click"
                       Content="{l:T 'Quitar seleccionadas'}" IsEnabled="False" />
        </Grid>
    </Grid>
</Page>
