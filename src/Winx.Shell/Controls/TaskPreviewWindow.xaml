<Window x:Class="Winx.Shell.Controls.TaskPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
        Title="{l:T 'Vista previa'}"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <!-- Sin AllowsTransparency: las miniaturas de DWM no se dibujan en ventanas en capas. -->
    <Border x:Name="Card" Background="{DynamicResource WinxPopupBackgroundBrush}" Padding="10,8,10,10"
            MouseLeftButtonUp="Card_Click" Cursor="Hand">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIcon" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" MaxWidth="220"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource WinxForegroundBrush}" />
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource TaskbarButton}" Width="24" Height="24"
                        Margin="8,0,0,0" Padding="0" ToolTip="{l:T 'Cerrar ventana'}" Click="Close_Click">
                    <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE8BB;" />
                </Button>
            </Grid>
            <!-- Aquí DWM dibuja la miniatura en vivo de la ventana -->
            <Border x:Name="ThumbHost" Width="240" Height="150" />
        </StackPanel>
    </Border>
</Window>
