<UserControl x:Class="Winx.Shell.Controls.TaskButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Winx.Shell.Services.Localization">
    <Button x:Name="MainButton" Style="{StaticResource TaskbarButton}" Padding="0" ToolTip="{Binding Title}"
            Click="Button_Click">
        <Button.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CloseItem" Header="{l:T 'Cerrar ventana'}" Click="CloseWindow_Click" />
            </ContextMenu>
        </Button.ContextMenu>
        <Grid x:Name="Root" Width="44">
            <!-- Varias ventanas agrupadas: el borde de otra "tarjeta" asoma detrás, como en Windows (ver UpdateGroup) -->
            <Path x:Name="StackEdge" Visibility="Collapsed" Fill="{DynamicResource WinxActiveTaskBrush}" />
            <Border x:Name="ActiveBackground" CornerRadius="{DynamicResource WinxCornerRadius}" Background="{DynamicResource WinxActiveTaskBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Active">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Ícono de la app, o del sitio si es una pestaña de YouTube, WhatsApp Web… (ver TaskGroups) -->
            <Grid x:Name="IconHost" Width="24" Height="24">
                <Image x:Name="AppIcon" RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- El navegador en chiquito, en la esquina del ícono del sitio -->
                <Image x:Name="BrowserBadge" Width="11" Height="11" Margin="0,0,-3,-3" Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>

            <!-- Indicador junto al borde de la pantalla (abajo en la barra inferior): corto = abierta, largo con acento = activa, ámbar = pide atención -->
            <Border x:Name="Indicator" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="6" />
                        <Setter Property="Background" Value="{DynamicResource WinxInactiveIndicatorBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Active">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Background" Value="{DynamicResource WinxAccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Flashing">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Background" Value="#FFE8A33D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Button>
</UserControl>
