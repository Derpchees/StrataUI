<start:StartMenuBase x:Class="Winx.Shell.StartMenu.StartMenuSpotlight"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:start="clr-namespace:Winx.Shell.StartMenu"
                     Title="Buscar" Width="680">
    <!-- Solo búsqueda (tipo Spotlight): una barra centrada; los anclados como íconos y los
         resultados aparecen debajo al escribir. -->
    <StackPanel Margin="14,14,14,12">
        <ui:TextBox x:Name="SearchBox" FontSize="18" PlaceholderText="Buscar apps o escribir un comando"
                    Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="Search_KeyDown">
            <ui:TextBox.Icon>
                <ui:SymbolIcon Symbol="Search24" FontSize="20" />
            </ui:TextBox.Icon>
        </ui:TextBox>

        <!-- Anclados: solo íconos, sin texto -->
        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Pinned}" ItemsPanel="{StaticResource WrapItems}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HomeVisible}" Value="True" />
                                <Condition Binding="{Binding ShowPinned}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource FlyoutIconButton}" Width="52" Height="52" Margin="2"
                            Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                            ToolTip="{Binding Name}" ContextMenu="{StaticResource AppContextMenu}">
                        <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer MaxHeight="420" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource AppRow}" />
                <TextBlock Style="{StaticResource FlyoutHint}" Margin="10,4"
                           Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}"
                           Text="Sin resultados. Pulsa Enter para ejecutarlo como comando." />
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</start:StartMenuBase>
