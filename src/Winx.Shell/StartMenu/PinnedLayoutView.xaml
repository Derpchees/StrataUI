<UserControl x:Class="Winx.Shell.StartMenu.PinnedLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:svc="clr-namespace:Winx.Shell.Services.StartMenu"
             xmlns:start="clr-namespace:Winx.Shell.StartMenu">
    <UserControl.Resources>
        <!-- App anclada: se abre con clic, se arrastra para mover o para crear una carpeta -->
        <DataTemplate DataType="{x:Type svc:StartApp}">
            <Button Style="{StaticResource FlyoutRow}" Width="{DynamicResource StartTileWidth}" Padding="4,10,4,8"
                    HorizontalContentAlignment="Center" ToolTip="{Binding Name}"
                    Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseDown" PreviewMouseMove="Tile_PreviewMouseMove"
                    RenderTransformOrigin="0.5,0.5">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T 'Abrir'}" Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}" />
                        <MenuItem Header="{l:T 'Desanclar de Inicio'}" Command="{x:Static start:StartCommands.TogglePin}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}"
                           Margin="{DynamicResource StartTileIconMargin}" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" FontSize="12" Visibility="{DynamicResource StartTileLabelVisibility}" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Carpeta: miniatura 2×2 de sus apps; clic para abrirla -->
        <DataTemplate DataType="{x:Type svc:PinFolderView}">
            <Button Style="{StaticResource FlyoutRow}" Width="{DynamicResource StartTileWidth}" Padding="4,10,4,8"
                    HorizontalContentAlignment="Center" ToolTip="{Binding Name}"
                    Click="Folder_Click"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseDown" PreviewMouseMove="Tile_PreviewMouseMove"
                    RenderTransformOrigin="0.5,0.5">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T 'Abrir carpeta'}" Click="FolderOpen_Click" />
                        <MenuItem Header="{l:T 'Desagrupar'}" Click="FolderUngroup_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel>
                    <Border Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}" Margin="{DynamicResource StartTileIconMargin}"
                            CornerRadius="{DynamicResource WinxCornerRadius}" Background="{DynamicResource WinxSurfaceBrush}" Padding="3">
                        <ItemsControl ItemsSource="{Binding Preview}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="2" Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding}" Margin="1" RenderOptions.BitmapScalingMode="HighQuality" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12" Visibility="{DynamicResource StartTileLabelVisibility}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl ItemsSource="{x:Static svc:PinLayout.Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <!-- Encabezado: doble clic o clic derecho para renombrar -->
                        <Grid Margin="8,0,8,4" Background="Transparent" MouseLeftButtonDown="SectionHeader_MouseDown">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T 'Renombrar sección'}" Click="SectionRename_Click" />
                                    <MenuItem Header="{l:T 'Nueva sección debajo'}" Click="SectionAdd_Click" />
                                    <Separator />
                                    <MenuItem Header="{l:T 'Eliminar sección'}" Click="SectionDelete_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <TextBlock Style="{StaticResource StartSectionTitle}" Text="{Binding Name}" />
                            <TextBox Visibility="Collapsed" Text="{Binding Name, Mode=OneTime}" MinWidth="160" HorizontalAlignment="Left"
                                     KeyDown="SectionEditor_KeyDown" LostFocus="SectionEditor_LostFocus" />
                        </Grid>
                        <!-- Zona de la sección: soltar en un hueco agrega al final -->
                        <ItemsControl ItemsSource="{Binding Tiles}" ItemsPanel="{StaticResource WrapItems}" MinHeight="44"
                                      Background="Transparent" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Style="{StaticResource FlyoutRow}" HorizontalAlignment="Left" Margin="0,0,0,4" Click="NewSection_Click">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Style="{StaticResource FlyoutHint}" Text="{l:T 'Nueva sección'}" />
            </StackPanel>
        </Button>

        <!-- Ícono que sigue al cursor mientras se arrastra -->
        <Popup x:Name="DragGhost" AllowsTransparency="True" Placement="Relative" IsHitTestVisible="False">
            <Border Padding="8" CornerRadius="{DynamicResource WinxCornerRadius}" Background="{DynamicResource WinxSurfaceBrush}" Opacity="0.9">
                <Image x:Name="DragGhostIcon" Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </Popup>

        <!-- Contenido de una carpeta abierta -->
        <Popup x:Name="FolderPopup" StaysOpen="False" AllowsTransparency="True" Placement="Center" PopupAnimation="Fade">
            <Border Width="360" Padding="16" CornerRadius="{DynamicResource WinxLargeCornerRadius}"
                    Background="{DynamicResource WinxPopupBackgroundBrush}"
                    BorderBrush="{DynamicResource WinxFlyoutBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBox x:Name="FolderName" FontSize="15" Margin="0,0,0,12" KeyDown="FolderName_KeyDown" LostFocus="FolderName_LostFocus" />
                    <ItemsControl x:Name="FolderApps" ItemsPanel="{StaticResource WrapItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FlyoutRow}" Width="{DynamicResource StartTileWidth}" Padding="4,10,4,8"
                                        HorizontalContentAlignment="Center" ToolTip="{Binding Name}"
                                        Command="{x:Static start:StartCommands.Launch}" CommandParameter="{Binding}"
                                        PreviewMouseLeftButtonDown="Tile_PreviewMouseDown" PreviewMouseMove="FolderApp_PreviewMouseMove">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:T 'Sacar de la carpeta'}" Click="FolderTakeOut_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <Image Source="{Binding Icon}" Width="{DynamicResource StartTileIconSize}" Height="{DynamicResource StartTileIconSize}"
                                               Margin="0,0,0,6" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FlyoutHint}" Margin="4,8,0,0"
                               Text="{l:T 'Arrastra una app fuera de la carpeta para sacarla.'}" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
