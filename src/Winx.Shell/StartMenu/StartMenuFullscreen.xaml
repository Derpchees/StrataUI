<start:StartMenuBase x:Class="Winx.Shell.StartMenu.StartMenuFullscreen"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
                     xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                     xmlns:start="clr-namespace:Winx.Shell.StartMenu"
                     Title="{l:T 'Inicio'}" SizeToContent="Manual">
    <!-- Clic en el fondo vacío cierra el menú -->
    <Grid Background="Transparent" MouseLeftButtonUp="Background_Click">
        <Grid MaxWidth="1200" Margin="48,56,48,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TextBox x:Name="SearchBox" Width="560" HorizontalAlignment="Center" FontSize="16"
                        PlaceholderText="{l:T 'Escribe para buscar apps'}"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="Search_KeyDown">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <ScrollViewer Grid.Row="1" Margin="0,32,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Visibility="{Binding HomeVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Visibility="{Binding ShowPinned, Converter={StaticResource BoolToVis}}">
                            <start:PinnedLayoutView />
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowAllAppsButton, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource StartSectionTitle}" FontSize="16" Margin="8,24,0,8" Text="{l:T 'Todas las apps'}" />
                            <ItemsControl ItemsSource="{Binding AllApps}" ItemTemplate="{StaticResource AppTileLarge}"
                                          ItemsPanel="{StaticResource WrapItems}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource AppTileLarge}"
                                      ItemsPanel="{StaticResource WrapItems}" />
                        <TextBlock Style="{StaticResource FlyoutHint}" HorizontalAlignment="Center" FontSize="14"
                                   Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}"
                                   Text="{l:T 'No hay apps con ese nombre. Pulsa Enter para ejecutarlo como comando.'}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <start:StartFooter Grid.Row="2" Margin="0,12,0,0" MaxWidth="560" />
        </Grid>
    </Grid>
</start:StartMenuBase>
