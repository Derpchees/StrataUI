<flyouts:FlyoutWindow x:Class="Winx.Shell.Flyouts.MediaFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                      xmlns:flyouts="clr-namespace:Winx.Shell.Flyouts"
                      Title="{l:T 'Multimedia'}" Width="380">
    <Grid ClipToBounds="True">
        <!-- Fondo: la carátula muy desenfocada, como en los reproductores modernos -->
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.35" IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="60" KernelType="Gaussian" />
            </Image.Effect>
        </Image>

        <StackPanel Margin="16,16,16,14">
            <!-- App de origen; con varias, se elige aquí cuál controlar -->
            <Grid Margin="2,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SourceText" Style="{StaticResource FlyoutHint}" />
                </StackPanel>
                <ComboBox x:Name="SourceBox" Grid.Column="1" MinWidth="130" Visibility="Collapsed"
                          DisplayMemberPath="Name" SelectionChanged="Source_Changed" />
            </Grid>

            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Carátula (o una nota si la app no la da) -->
                <Border Width="112" Height="112" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource WinxSurfaceBrush}">
                    <Grid ClipToBounds="True">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="40" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border CornerRadius="10">
                            <Border.Background>
                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,4,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ArtistText" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Avance -->
            <Grid x:Name="TimelinePanel" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="Position_DragStart" PreviewMouseLeftButtonUp="Position_DragEnd" />
                <TextBlock x:Name="PositionText" Grid.Row="1" Style="{StaticResource FlyoutHint}" HorizontalAlignment="Left" />
                <TextBlock x:Name="DurationText" Grid.Row="1" Style="{StaticResource FlyoutHint}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Controles -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="PreviousButton" Style="{StaticResource FlyoutIconButton}" Width="44" Height="44"
                        Click="Previous_Click" ToolTip="{l:T 'Anterior'}">
                    <ui:SymbolIcon Symbol="Previous24" FontSize="20" Filled="True" />
                </Button>
                <Button x:Name="PlayButton" Width="52" Height="52" Margin="14,0" Click="PlayPause_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="26" Background="{DynamicResource WinxAccentBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" FontSize="22" Filled="True"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource FlyoutIconButton}" Width="44" Height="44"
                        Click="Next_Click" ToolTip="{l:T 'Siguiente'}">
                    <ui:SymbolIcon Symbol="Next24" FontSize="20" Filled="True" />
                </Button>
            </StackPanel>

            <TextBlock x:Name="EmptyText" Style="{StaticResource FlyoutHint}" HorizontalAlignment="Center" Margin="0,8"
                       Visibility="Collapsed" Text="{l:T 'No se está reproduciendo nada.'}" />
        </StackPanel>
    </Grid>
</flyouts:FlyoutWindow>
