<flyouts:FlyoutWindow x:Class="Winx.Shell.Flyouts.NetworkFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                      xmlns:flyouts="clr-namespace:Winx.Shell.Flyouts"
                      Title="{l:T 'Red'}" Width="380">
    <StackPanel Margin="14,16,14,14">
        <TextBlock Style="{StaticResource FlyoutTitle}" Margin="4,0,0,0" Text="{l:T 'Red'}" />

        <!-- Conexión actual -->
        <Border Margin="0,12,0,0" Padding="12" CornerRadius="{DynamicResource WinxLargeCornerRadius}"
                Background="{DynamicResource WinxSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon x:Name="ConnectionIcon" Symbol="PlugConnected24" FontSize="22" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ConnectionName" Style="{StaticResource FlyoutText}" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionStatus" Style="{StaticResource FlyoutHint}" />
                    <TextBlock x:Name="ConnectionAddress" Style="{StaticResource FlyoutHint}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Wi-Fi -->
        <Grid Margin="0,16,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FlyoutSection}" Margin="4,0,0,0" VerticalAlignment="Center" Text="WI-FI" />
            <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource FlyoutIconButton}" ToolTip="{l:T 'Buscar redes'}"
                    Click="Scan_Click">
                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
            </Button>
            <ui:ToggleSwitch x:Name="WifiSwitch" Grid.Column="2" Margin="8,0,0,0" Click="WifiSwitch_Click" />
        </Grid>

        <TextBlock x:Name="WifiHint" Style="{StaticResource FlyoutHint}" Margin="4,0,0,6" Visibility="Collapsed" />
        <ui:ProgressRing x:Name="ScanProgress" IsIndeterminate="True" Width="24" Height="24" Margin="0,4"
                         Visibility="Collapsed" />

        <ItemsControl x:Name="NetworkList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Button Style="{StaticResource FlyoutRow}" Click="Network_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="{Binding SignalSymbol}" FontSize="18" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding Ssid}" />
                                    <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Detail}" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" Symbol="LockClosed24" FontSize="14"
                                               Visibility="{Binding LockVisibility}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <!-- Panel de conexión al seleccionar una red -->
                        <StackPanel Margin="40,2,10,10" Visibility="{Binding ExpandedVisibility}">
                            <PasswordBox Margin="0,0,0,8" Visibility="{Binding PasswordVisibility}"
                                         Loaded="PasswordBox_Loaded" KeyDown="PasswordBox_KeyDown" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Margin="0,0,0,8" Text="{Binding Message}"
                                       Visibility="{Binding MessageVisibility}" />
                            <ui:Button HorizontalAlignment="Right" Appearance="Primary" MinWidth="110"
                                       Content="{Binding ActionText}" Click="NetworkAction_Click" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</flyouts:FlyoutWindow>
