<flyouts:FlyoutWindow x:Class="Winx.Shell.Flyouts.VolumeFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                      xmlns:flyouts="clr-namespace:Winx.Shell.Flyouts"
                      Title="Volumen" Width="380">
    <StackPanel Margin="14,16,14,14">
        <TextBlock Style="{StaticResource FlyoutTitle}" Margin="4,0,0,0" Text="Volumen" />

        <!-- Volumen general del dispositivo predeterminado -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MasterMuteButton" Style="{StaticResource FlyoutIconButton}" Click="MasterMute_Click">
                <ui:SymbolIcon x:Name="MasterMuteIcon" Symbol="Speaker224" FontSize="18" />
            </Button>
            <Slider x:Name="MasterSlider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                    Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                    ValueChanged="MasterSlider_ValueChanged" />
            <TextBlock x:Name="MasterPercent" Grid.Column="2" Style="{StaticResource FlyoutPercent}" />
        </Grid>

        <TextBlock Style="{StaticResource FlyoutSection}" Text="DISPOSITIVO DE SALIDA" />
        <ItemsControl x:Name="DeviceList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource FlyoutRow}" Click="Device_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FlyoutText}" Text="{Binding Name}" />
                            <ui:SymbolIcon Grid.Column="2" Symbol="Checkmark24" FontSize="16" Margin="8,0,0,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource FlyoutSection}" Text="APLICACIONES" />
        <ItemsControl x:Name="AppList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2,0,6">
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,2">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Name}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource FlyoutIconButton}" Command="{Binding ToggleMute}">
                                <ui:SymbolIcon Symbol="{Binding MuteSymbol}" FontSize="16" />
                            </Button>
                            <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                    Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                    Value="{Binding Volume, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource FlyoutPercent}"
                                       Text="{Binding Volume, StringFormat={}{0:0}}" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoAppsText" Style="{StaticResource FlyoutHint}" Margin="4,0,0,4"
                   Text="Ninguna aplicación está usando el audio ahora." Visibility="Collapsed" />
    </StackPanel>
</flyouts:FlyoutWindow>
