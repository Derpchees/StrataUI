<flyouts:FlyoutWindow x:Class="Winx.Shell.Flyouts.VolumeFlyout"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                      xmlns:flyouts="clr-namespace:Winx.Shell.Flyouts"
                      Title="Volumen" Width="360">
    <StackPanel Margin="12,14,12,10">
        <!-- Volumen general del dispositivo predeterminado: lo único visible por defecto -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MasterMuteButton" Style="{StaticResource FlyoutIconButton}" Click="MasterMute_Click">
                <ui:SymbolIcon x:Name="MasterMuteIcon" Symbol="Speaker224" FontSize="18" />
            </Button>
            <Slider x:Name="MasterSlider" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                    Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                    ValueChanged="MasterSlider_ValueChanged" />
            <TextBlock x:Name="MasterPercent" Grid.Column="2" Style="{StaticResource FlyoutPercent}" />
        </Grid>

        <Separator Margin="0,10,0,4" Opacity="0.4" />

        <!-- Dispositivo de salida (plegable) -->
        <Button x:Name="DevicesHeader" Style="{StaticResource FlyoutRow}" Click="DevicesHeader_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="SpeakerSettings24" FontSize="16" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FlyoutText}" Text="Dispositivo de salida" />
                    <TextBlock x:Name="CurrentDeviceText" Style="{StaticResource FlyoutHint}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:SymbolIcon x:Name="DevicesChevron" Grid.Column="2" Symbol="ChevronDown24" FontSize="14"
                               RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </Grid>
        </Button>
        <ItemsControl x:Name="DeviceList" Margin="28,0,0,4" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource FlyoutRow}" Padding="10,6" Click="Device_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FlyoutText}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="Checkmark24" FontSize="14" Margin="8,0,0,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Volumen por aplicación (plegable) -->
        <Button x:Name="AppsHeader" Style="{StaticResource FlyoutRow}" Click="AppsHeader_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Apps24" FontSize="16" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FlyoutText}" Text="Aplicaciones" />
                    <TextBlock x:Name="AppsSummaryText" Style="{StaticResource FlyoutHint}" TextWrapping="NoWrap" />
                </StackPanel>
                <ui:SymbolIcon x:Name="AppsChevron" Grid.Column="2" Symbol="ChevronDown24" FontSize="14"
                               RenderTransformOrigin="0.5,0.5">
                    <ui:SymbolIcon.RenderTransform>
                        <RotateTransform />
                    </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
            </Grid>
        </Button>
        <StackPanel x:Name="AppsPanel" Margin="4,4,0,0" Visibility="Collapsed">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Ícono de la app: clic para silenciarla -->
                            <Button Style="{StaticResource FlyoutIconButton}" Command="{Binding ToggleMute}"
                                    ToolTip="{Binding Name}">
                                <Grid>
                                    <Image Source="{Binding Icon}" Width="18" Height="18"
                                           RenderOptions.BitmapScalingMode="HighQuality" Opacity="{Binding IconOpacity}" />
                                    <ui:SymbolIcon Symbol="SpeakerMute24" FontSize="12" HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                                                   Visibility="{Binding MutedVisibility}" />
                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Visibility="{Binding FallbackIconVisibility}" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource FlyoutHint}" Text="{Binding Name}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <Slider Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                        Value="{Binding Volume, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Style="{StaticResource FlyoutPercent}"
                                       Text="{Binding Volume, StringFormat={}{0:0}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoAppsText" Style="{StaticResource FlyoutHint}" Margin="4,0,0,4"
                       Text="Ninguna aplicación está usando el audio ahora." Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</flyouts:FlyoutWindow>
