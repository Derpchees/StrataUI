<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WINX</AssemblyName>
    <RootNamespace>Winx.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- El DPI lo declara el manifiesto (correcto para WPF); el aviso es solo para apps WinForms. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms solo se usa para Screen/SystemInformation; evitamos choques de nombres con WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
  </ItemGroup>

</Project>
