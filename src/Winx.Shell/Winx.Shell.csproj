<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 habilita las APIs de WinRT (Wi-Fi, Bluetooth, radios) para los módulos de estado. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WINX</AssemblyName>
    <RootNamespace>Winx.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\winx.ico</ApplicationIcon>
    <!-- El DPI lo declara el manifiesto (correcto para WPF); el aviso es solo para apps WinForms. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Memoria: el recolector concurrente reserva un hilo y memoria extra que un shell en reposo
         no necesita; ConserveMemory compacta antes para no acumular huecos. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Winx.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms solo se usa para Screen/SystemInformation; evitamos choques de nombres con WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\winx.ico" />
    <!-- Traducciones de la interfaz (ver Services/Localization/Loc.cs) -->
    <EmbeddedResource Include="Localization\*.json" LogicalName="Winx.Shell.Localization.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
