<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TaskbarBackgroundBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="TaskbarBorderBrush" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FFC5C5C5" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ActiveTaskBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="InactiveIndicatorBrush" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#FF3C3C3C" />
</ResourceDictionary>
