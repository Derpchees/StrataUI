<ui:FluentWindow x:Class="Winx.Shell.Hub.HubWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Winx.Shell.Hub.Pages"
                 Title="WINX"
                 Width="1040" Height="720" MinWidth="780" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
    <!-- Tinte del tema sobre el material de fondo (opaco en Material, sutil en los de vidrio) -->
    <Grid Background="{DynamicResource WinxHubTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="HubTitleBar" Grid.Row="0" Title="WINX" />

        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           OpenPaneLength="250">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Barra de tareas" TargetPageType="{x:Type pages:TaskbarPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PanelBottom20" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Menú Inicio" TargetPageType="{x:Type pages:StartPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Grid24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Bandeja del sistema" TargetPageType="{x:Type pages:TrayPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Apps24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Apariencia" TargetPageType="{x:Type pages:AppearancePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PaintBrush24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Optimización">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Wrench24" />
                    </ui:NavigationViewItem.Icon>
                    <ui:NavigationViewItem.MenuItems>
                        <ui:NavigationViewItem Content="Apps preinstaladas" TargetPageType="{x:Type pages:AppsPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Privacidad" TargetPageType="{x:Type pages:PrivacyPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ShieldLock24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Inteligencia artificial" TargetPageType="{x:Type pages:AIPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="BrainCircuit24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Sistema" TargetPageType="{x:Type pages:SystemTweaksPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Desktop24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Windows Update" TargetPageType="{x:Type pages:UpdatePage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Apariencia de Windows" TargetPageType="{x:Type pages:WindowsAppearancePage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DarkTheme24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Explorador" TargetPageType="{x:Type pages:ExplorerPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Folder24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Multitarea" TargetPageType="{x:Type pages:MultitaskingPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="SquareMultiple24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Juegos" TargetPageType="{x:Type pages:GamingPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Games24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Navegadores" TargetPageType="{x:Type pages:BrowsersPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Globe24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="Respaldo" TargetPageType="{x:Type pages:BackupPage}">
                            <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="History24" /></ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationViewItem.MenuItems>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="General" TargetPageType="{x:Type pages:GeneralPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
