<Page x:Class="Winx.Shell.Hub.Pages.TrayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Winx.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Bandeja del sistema'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="Apps24" Title="{l:T 'Bandeja y área de estado'}" Subtitle="{l:T 'Red, Bluetooth, brillo, sonido, reloj e íconos de la bandeja.'}" />

            <TextBlock Style="{StaticResource HubSectionTitle}" Margin="2,0,0,8" Text="{l:T 'Módulos del área de estado'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Wifi124" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Red'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Estado de la conexión y redes Wi-Fi'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NetworkSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Bluetooth24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Bluetooth'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Activar Bluetooth y conectar dispositivos'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BluetoothSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Speaker224" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Volumen'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Dispositivo de salida y volumen por aplicación'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="VolumeSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="BrightnessHigh24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Brillo'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Brillo de cada monitor (DDC/CI) o de la pantalla del portátil. La rueda del mouse sobre el botón lo ajusta.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BrightnessSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Battery524" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Batería'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Solo aparece en equipos con batería'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BatterySwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Reloj'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Clock24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar segundos'}" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SecondsSwitch" Click="Clock_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="CalendarLtr24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar fecha'}" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="DateSwitch" Click="Clock_Changed" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Íconos de la bandeja'}" />
            <TextBlock Style="{StaticResource CardDescription}" Margin="2,-4,0,10"
                       Text="{l:T 'Elige qué íconos se muestran siempre en la barra. Los demás quedan en el menú de íconos ocultos (^). Solo aparecen las apps que están abiertas ahora. En la barra también puedes arrastrarlos para ordenarlos o moverlos entre la barra y los ocultos.'}" />

            <ItemsControl x:Name="IconList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardControl Style="{StaticResource HubCard}">
                            <ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Image}" Width="20" Height="20" Margin="0,0,14,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource CardDescription}" Text="{Binding Detail}" />
                                    </StackPanel>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardDescription}" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Text="{l:T 'Mostrar siempre'}" />
                                <ui:ToggleSwitch IsChecked="{Binding IsPinned, Mode=OneWay}" Click="Pin_Click" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Style="{StaticResource CardDescription}" Visibility="Collapsed"
                       Text="{l:T 'No hay íconos en la bandeja en este momento.'}" />
        </StackPanel>
    </ScrollViewer>
</Page>
