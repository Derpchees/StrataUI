<Page x:Class="Winx.Shell.Hub.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Winx.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Notificaciones'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="Alert24" Title="{l:T 'Notificaciones'}"
                            Subtitle="{l:T 'Centro de notificaciones junto al reloj (o Win+N) y avisos en el monitor y la esquina que elijas.'}" />

            <!-- Sin permiso de Windows -->
            <ui:InfoBar x:Name="DeniedBar" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,0,0,12"
                        Title="{l:T 'Windows no permite a WINX leer las notificaciones.'}"
                        Message="{l:T 'Actívalo en Configuración › Privacidad y seguridad › Notificaciones.'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="AlertOn24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Centro de notificaciones de WINX'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Desactivado, el reloj y Win+N abren el de Windows.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="EnabledSwitch" Click="Enabled_Click" />
            </ui:CardControl>

            <StackPanel x:Name="Options">
                <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Avisos'}" />

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="ChatBubblesQuestion24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar avisos emergentes'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Un aviso breve cuando llega una notificación. No aparecen con una app a pantalla completa.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="BannersSwitch" Click="Banners_Click" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="AlertSnooze24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'No molestar'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Las notificaciones llegan al centro, pero sin avisos.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="DndSwitch" Click="Dnd_Click" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Timer24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Duración'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Cuánto tiempo se ve cada aviso. Con el mouse encima no se cierra.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="DurationBox" MinWidth="160" SelectionChanged="Duration_Changed">
                        <ComboBoxItem Content="{l:T '4 segundos'}" Tag="4" />
                        <ComboBoxItem Content="{l:T '6 segundos'}" Tag="6" />
                        <ComboBoxItem Content="{l:T '10 segundos'}" Tag="10" />
                        <ComboBoxItem Content="{l:T '20 segundos'}" Tag="20" />
                    </ComboBox>
                </ui:CardControl>

                <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Posición'}" />

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Desktop24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Monitor'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Numerados de izquierda a derecha, como en la página de la barra.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="ScreenBox" MinWidth="240" SelectionChanged="Screen_Changed" />
                </ui:CardControl>

                <!-- Esquina: un dibujo de la pantalla con una opción en cada esquina -->
                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowExpand24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Esquina'}" />
                            <TextBlock x:Name="CornerText" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Border Width="200" Height="124" CornerRadius="8" BorderThickness="2"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <RadioButton x:Name="TopLeft" Style="{StaticResource CornerOption}" GroupName="Corner" Tag="TopLeft"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Checked="Corner_Checked"
                                         ToolTip="{l:T 'Arriba a la izquierda'}" />
                            <RadioButton x:Name="TopRight" Style="{StaticResource CornerOption}" GroupName="Corner" Tag="TopRight"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Checked="Corner_Checked"
                                         ToolTip="{l:T 'Arriba a la derecha'}" />
                            <RadioButton x:Name="BottomLeft" Style="{StaticResource CornerOption}" GroupName="Corner" Tag="BottomLeft"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Checked="Corner_Checked"
                                         ToolTip="{l:T 'Abajo a la izquierda'}" />
                            <RadioButton x:Name="BottomRight" Style="{StaticResource CornerOption}" GroupName="Corner" Tag="BottomRight"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Checked="Corner_Checked"
                                         ToolTip="{l:T 'Abajo a la derecha'}" />
                        </Grid>
                    </Border>
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Play24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Probar'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Muestra un aviso de ejemplo donde aparecerán.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{l:T 'Mostrar un aviso de prueba'}" Icon="{ui:SymbolIcon Alert24}" Click="Test_Click" />
                </ui:CardControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
