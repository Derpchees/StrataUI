<Page x:Class="Winx.Shell.Hub.Pages.TaskbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Barra de tareas"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <TextBlock Style="{StaticResource HubPageTitle}" Text="Barra de tareas" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="AlignCenterHorizontal24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Alineación" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Posición del botón Inicio y de las apps abiertas (en barras verticales, Izquierda es arriba)" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="AlignmentBox" MinWidth="160" SelectionChanged="Alignment_Changed">
                    <ComboBoxItem Content="Centro" />
                    <ComboBoxItem Content="Izquierda" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowAutofitHeight24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Tamaño" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Grosor de la barra en todos los monitores" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="HeightBox" MinWidth="160" SelectionChanged="Height_Changed">
                    <ComboBoxItem Content="Compacta" Tag="40" />
                    <ComboBoxItem Content="Normal" Tag="48" />
                    <ComboBoxItem Content="Grande" Tag="56" />
                </ComboBox>
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="Monitores" />
            <TextBlock Style="{StaticResource CardDescription}" Margin="0,-4,0,8"
                       Text="Cada monitor tiene su propia barra; elige en qué borde va. Numerados de izquierda a derecha." />
            <StackPanel x:Name="MonitorList" />

            <ui:CardControl x:Name="PerMonitorCard" Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowMultiple16" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Cada barra muestra solo las ventanas de su monitor" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Desactivado, todas las barras muestran todas las ventanas." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="PerMonitorSwitch" Click="PerMonitor_Click" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="Reloj" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Clock24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Mostrar segundos" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SecondsSwitch" Click="Clock_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="CalendarLtr24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Mostrar fecha" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="DateSwitch" Click="Clock_Changed" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="Módulos del área de estado" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Wifi124" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Red" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Estado de la conexión y redes Wi-Fi" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NetworkSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Bluetooth24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Bluetooth" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Activar Bluetooth y conectar dispositivos" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BluetoothSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Speaker224" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Volumen" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Dispositivo de salida y volumen por aplicación" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="VolumeSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Battery524" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Batería" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Solo aparece en equipos con batería" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BatterySwitch" Click="Modules_Changed" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
