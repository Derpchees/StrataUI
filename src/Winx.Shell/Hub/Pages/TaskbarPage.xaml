<Page x:Class="Winx.Shell.Hub.Pages.TaskbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Barra de tareas'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <TextBlock Style="{StaticResource HubPageTitle}" Text="{l:T 'Barra de tareas'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="AlignCenterHorizontal24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Alineación'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Posición del botón Inicio y de las apps abiertas (en barras verticales, Izquierda es arriba)'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="AlignmentBox" MinWidth="200" SelectionChanged="Alignment_Changed">
                    <ComboBoxItem Content="{l:T 'Igual que Windows'}" Tag="Windows" />
                    <ComboBoxItem Content="{l:T 'Centro'}" Tag="Center" />
                    <ComboBoxItem Content="{l:T 'Izquierda'}" Tag="Left" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="CenterHorizontal24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Centrar las apps abiertas'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Con Inicio a la izquierda, las apps quedan igual al centro de la barra.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="CenterAppsSwitch" Click="CenterApps_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowAutofitHeight24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Tamaño'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Grosor de la barra en todos los monitores'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="HeightBox" MinWidth="160" SelectionChanged="Height_Changed">
                    <ComboBoxItem Content="{l:T 'Compacta'}" Tag="40" />
                    <ComboBoxItem Content="{l:T 'Normal'}" Tag="48" />
                    <ComboBoxItem Content="{l:T 'Grande'}" Tag="56" />
                </ComboBox>
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Monitores'}" />
            <TextBlock Style="{StaticResource CardDescription}" Margin="0,-4,0,8"
                       Text="{l:T 'Cada monitor tiene su propia barra; elige en qué borde va. Numerados de izquierda a derecha.'}" />
            <StackPanel x:Name="MonitorList" />

            <!-- Opciones de varios monitores (ocultas con uno solo) -->
            <StackPanel x:Name="MultiMonitorOptions">
                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Star24" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Monitor principal de WINX'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Lleva la bandeja del sistema y abre el menú con la tecla Windows. No cambia el monitor principal de Windows.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="MainScreenBox" MinWidth="200" SelectionChanged="MainScreen_Changed" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowMultiple16" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar las apps abiertas en'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'En qué barras aparece cada ventana.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="AppsModeBox" MinWidth="260" SelectionChanged="AppsMode_Changed">
                        <ComboBoxItem Content="{l:T 'Igual que Windows'}" Tag="Windows" />
                        <ComboBoxItem Content="{l:T 'Todas las barras'}" Tag="AllTaskbars" />
                        <ComboBoxItem Content="{l:T 'La principal y la del monitor de la ventana'}" Tag="MainAndOwn" />
                        <ComboBoxItem Content="{l:T 'Solo la del monitor de la ventana'}" Tag="OwnOnly" />
                    </ComboBox>
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource HubCard}">
                    <ui:CardControl.Icon><ui:SymbolIcon Symbol="Speaker224" /></ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Red, Bluetooth, sonido y reloj en todas las barras'}" />
                            <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Desactivado, solo aparecen en la barra principal, junto a la bandeja.'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="StatusAllSwitch" Click="StatusAll_Click" />
                </ui:CardControl>
            </StackPanel>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Reloj'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Clock24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar segundos'}" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SecondsSwitch" Click="Clock_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="CalendarLtr24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Mostrar fecha'}" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="DateSwitch" Click="Clock_Changed" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Módulos del área de estado'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Wifi124" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Red'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Estado de la conexión y redes Wi-Fi'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NetworkSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Bluetooth24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Bluetooth'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Activar Bluetooth y conectar dispositivos'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BluetoothSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Speaker224" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Volumen'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Dispositivo de salida y volumen por aplicación'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="VolumeSwitch" Click="Modules_Changed" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Battery524" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Batería'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Solo aparece en equipos con batería'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BatterySwitch" Click="Modules_Changed" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
