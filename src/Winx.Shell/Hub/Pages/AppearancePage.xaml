<Page x:Class="Winx.Shell.Hub.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
      xmlns:hub="clr-namespace:Winx.Shell.Hub"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="{l:T 'Apariencia'}"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <hub:PageHeader Icon="PaintBrush24" Title="{l:T 'Apariencia'}" Subtitle="{l:T 'Tema, color de acento y fondo de pantalla de WINX.'}" />

            <TextBlock Style="{StaticResource HubSectionTitle}" Margin="0,0,0,8" Text="{l:T 'Tema'}" />
            <WrapPanel x:Name="ThemeGallery" Margin="0,0,0,8" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Drop24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Refracción en vivo (Liquid Glass)'}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="{l:T 'Vidrio real: el fondo se curva en los bordes con colores vivos. Mientras esté activo, la barra y los paneles no aparecen en capturas de pantalla ni grabaciones.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="LiveGlassSwitch" Click="LiveGlass_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Eye24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Barra totalmente transparente'}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="{l:T 'Sin fondo, borde ni desenfoque: solo se ven los íconos y el texto. Cada parte de la barra se pone clara u oscura según el fondo que tenga detrás.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="TransparentSwitch" Click="Transparent_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowSettings20" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Aplicar el tema a Windows'}" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="{l:T 'Modo claro/oscuro del sistema y fondo del tema en el Explorador y el Panel de control. El contenido de esas ventanas sigue siendo sólido.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="WindowsThemeSwitch" Click="WindowsTheme_Click" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Animaciones'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Estilo'}" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="{l:T 'Cómo aparecen y se van los paneles, el menú Inicio, los avisos, los menús y las páginas del Hub.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="AnimationBox" MinWidth="180" SelectionChanged="Animation_Changed">
                    <ComboBoxItem Content="{l:T 'Deslizar'}" Tag="Slide" />
                    <ComboBoxItem Content="{l:T 'Desvanecer'}" Tag="Fade" />
                    <ComboBoxItem Content="{l:T 'Acercar'}" Tag="Zoom" />
                    <ComboBoxItem Content="{l:T 'Rebote'}" Tag="Pop" />
                    <ComboBoxItem Content="{l:T 'Subir desde lejos'}" Tag="Rise" />
                    <ComboBoxItem Content="{l:T 'Sin animación'}" Tag="None" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Timer24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Velocidad'}" VerticalAlignment="Center" />
                </ui:CardControl.Header>
                <ComboBox x:Name="SpeedBox" MinWidth="180" SelectionChanged="Animation_Changed">
                    <ComboBoxItem Content="{l:T 'Rápida'}" Tag="Fast" />
                    <ComboBoxItem Content="{l:T 'Normal'}" Tag="Normal" />
                    <ComboBoxItem Content="{l:T 'Lenta'}" Tag="Slow" />
                </ComboBox>
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Color de acento'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Color24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Origen del color'}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{l:T 'Con Aplicar el tema a Windows, Windows también usa el color del fondo o el propio.'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="AccentPreview" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0"
                            Background="{DynamicResource WinxAccentBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="AccentSourceBox" MinWidth="200" SelectionChanged="AccentSource_Changed">
                        <ComboBoxItem Content="{l:T 'El de Windows'}" Tag="Windows" />
                        <ComboBoxItem x:Name="WallpaperAccentItem" Content="{l:T 'Del fondo de pantalla'}" Tag="Wallpaper" />
                        <ComboBoxItem Content="{l:T 'Elegido por mí'}" Tag="Custom" />
                    </ComboBox>
                </StackPanel>
            </ui:CardControl>

            <!-- Wallpaper Engine cambia el acento de Windows con cada fondo: las dos cosas se pisarían -->
            <ui:InfoBar x:Name="WallpaperEngineBar" Margin="0,0,0,4" Severity="Warning" IsClosable="False" IsOpen="False"
                        Title="{l:T 'Wallpaper Engine está cambiando el color de Windows'}"
                        Message="{l:T 'Mientras tenga activado Ajustar el color de Windows (Configuración › General), WINX no saca el color del fondo ni cambia el acento de Windows. Desactívalo ahí y esta opción vuelve sola.'}" />

            <Border x:Name="SwatchPanel" Margin="0,0,0,4" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <WrapPanel x:Name="Swatches" />
            </Border>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="{l:T 'Fondo de pantalla'}" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="160" Height="90" CornerRadius="6" ClipToBounds="True" Margin="0,0,16,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Image x:Name="WallpaperPreview" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:T 'Imagen del escritorio'}" />
                            <TextBlock x:Name="WallpaperPath" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="RestoreWallpaperButton" Content="{l:T 'Restaurar original'}" Margin="0,0,8,0"
                               Click="RestoreWallpaper_Click" />
                    <ui:Button Content="{l:T 'Elegir imagen…'}" Appearance="Primary" Click="ChooseWallpaper_Click" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
