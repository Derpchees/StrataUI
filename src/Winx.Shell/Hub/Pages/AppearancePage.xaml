<Page x:Class="Winx.Shell.Hub.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Apariencia"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
        <StackPanel Style="{StaticResource HubPageContent}">
            <TextBlock Style="{StaticResource HubPageTitle}" Text="Apariencia" />

            <TextBlock Style="{StaticResource HubSectionTitle}" Margin="0,0,0,8" Text="Tema" />
            <WrapPanel x:Name="ThemeGallery" Margin="0,0,0,8" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Drop24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Refracción en vivo (Liquid Glass)" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Vidrio real: el fondo se curva en los bordes con colores vivos. Mientras esté activo, la barra y los paneles no aparecen en capturas de pantalla ni grabaciones." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="LiveGlassSwitch" Click="LiveGlass_Click" />
            </ui:CardControl>

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WindowSettings20" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Aplicar el tema a Windows" />
                        <TextBlock Style="{StaticResource CardDescription}"
                                   Text="Modo claro/oscuro del sistema y fondo del tema en el Explorador y el Panel de control. El contenido de esas ventanas sigue siendo sólido." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="WindowsThemeSwitch" Click="WindowsTheme_Click" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="Color de acento" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Color24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Usar el color de acento de Windows" />
                        <TextBlock Style="{StaticResource CardDescription}" Text="Desactívalo para elegir un color propio para WINX" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="WindowsAccentSwitch" Click="WindowsAccent_Click" />
            </ui:CardControl>

            <Border x:Name="SwatchPanel" Margin="0,0,0,4" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <WrapPanel x:Name="Swatches" />
            </Border>

            <TextBlock Style="{StaticResource HubSectionTitle}" Text="Fondo de pantalla" />

            <ui:CardControl Style="{StaticResource HubCard}">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="160" Height="90" CornerRadius="6" ClipToBounds="True" Margin="0,0,16,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Image x:Name="WallpaperPreview" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Imagen del escritorio" />
                            <TextBlock x:Name="WallpaperPath" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="RestoreWallpaperButton" Content="Restaurar original" Margin="0,0,8,0"
                               Click="RestoreWallpaper_Click" />
                    <ui:Button Content="Elegir imagen…" Appearance="Primary" Click="ChooseWallpaper_Click" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
