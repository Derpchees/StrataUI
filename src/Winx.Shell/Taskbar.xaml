<appbar:AppBarWindow x:Class="Winx.Shell.Taskbar"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:l="clr-namespace:Winx.Shell.Services.Localization"
                     xmlns:appbar="clr-namespace:ManagedShell.AppBar;assembly=ManagedShell.AppBar"
                     xmlns:controls="clr-namespace:Winx.Shell.Controls"
                     xmlns:conv="clr-namespace:Winx.Shell.Converters"
                     Title="WINX"
                     WindowStyle="None"
                     ResizeMode="NoResize"
                     ShowInTaskbar="False"
                     ShowActivated="False"
                     Topmost="True"
                     UseLayoutRounding="True"
                     FontFamily="{StaticResource UiFont}"
                     Background="Transparent">

    <appbar:AppBarWindow.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </appbar:AppBarWindow.Resources>

    <appbar:AppBarWindow.ContextMenu>
        <ContextMenu>
            <MenuItem Header="{l:T 'Configuración de WINX'}" FontWeight="SemiBold" Click="OpenHub_Click" />
            <Separator />
            <MenuItem Header="{l:T 'Administrador de tareas'}" Click="TaskManager_Click" />
            <MenuItem Header="{l:T 'Configuración de Windows'}" Click="WindowsSettings_Click" />
            <Separator />
            <MenuItem Header="{l:T 'Reiniciar WINX'}" Click="RestartWinx_Click" />
            <MenuItem Header="{l:T 'Salir de WINX'}" Click="ExitWinx_Click" />
            <Separator />
            <MenuItem x:Name="VersionItem" IsEnabled="False" />
        </ContextMenu>
    </appbar:AppBarWindow.ContextMenu>

    <!-- La ventana es transparente: el color del tema lo pone este Border (sobre el desenfoque si
         aplica). En temas flotantes se separa de los bordes y toma forma de cápsula. -->
    <Border x:Name="BarBorder" Background="{DynamicResource WinxTaskbarBackgroundBrush}"
            BorderBrush="{DynamicResource WinxTaskbarEdgeBrush}"
            BorderThickness="{DynamicResource WinxTaskbarBorderThickness}"
            CornerRadius="{DynamicResource WinxTaskbarCornerRadius}">
        <!-- En Liquid Glass con refracción en vivo, aquí se inserta la superficie de vidrio (por código) -->
        <Grid x:Name="GlassHost">
            <!-- Brillo interior sutil del vidrio -->
            <Border IsHitTestVisible="False" Background="{DynamicResource WinxGlassHighlightBrush}"
                    CornerRadius="{DynamicResource WinxTaskbarCornerRadius}"
                    Visibility="{DynamicResource WinxGlassVisibility}" />
            <!-- En barras verticales (izquierda/derecha) las columnas pasan a filas: ver ApplyOrientation -->
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
    
                <!-- Inicio + ventanas abiertas; alineación configurable desde el Hub -->
                <!-- DockPanel (no StackPanel) para que la lista reciba un ancho limitado y pueda desplazarse -->
                <DockPanel x:Name="TaskArea" Grid.Column="0" HorizontalAlignment="Center" LastChildFill="True">
                    <!-- El ícono se elige en Hub › Menú Inicio (ver Controls/StartIcons) -->
                    <Button x:Name="StartButton" DockPanel.Dock="Left" Style="{StaticResource TaskbarButton}" Width="44"
                            Padding="0" ToolTip="{l:T 'Inicio'}" Click="StartButton_Click" />

    
                    <!-- Si no caben todas las ventanas, la rueda del mouse desplaza la lista -->
                    <ScrollViewer x:Name="TaskScroller" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" Focusable="False"
                                  PreviewMouseWheel="TaskScroller_PreviewMouseWheel">
                        <ItemsControl x:Name="TaskList" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TaskButton />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
    
                <!-- Bandeja, estado del sistema, reloj y "mostrar escritorio" -->
                <StackPanel x:Name="StatusPanel" Grid.Column="1" Orientation="Horizontal">
                    <StackPanel x:Name="TrayArea" Orientation="Horizontal">
                        <ToggleButton x:Name="ChevronButton" Style="{StaticResource TaskbarButton}" Width="28"
                                      Padding="0" ToolTip="{l:T 'Mostrar iconos ocultos'}"
                                      IsChecked="{Binding IsOpen, ElementName=HiddenTrayPopup, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=HiddenTrayPopup, Converter={StaticResource InverseBool}}">
                            <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE70E;" />
                        </ToggleButton>
                        <Popup x:Name="HiddenTrayPopup" PlacementTarget="{Binding ElementName=ChevronButton}"
                               Placement="Top" VerticalOffset="-8" StaysOpen="False"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource WinxPopupBackgroundBrush}"
                                    BorderBrush="{DynamicResource WinxFlyoutBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource WinxLargeCornerRadius}" Padding="6">
                                <ItemsControl x:Name="HiddenTray" MaxWidth="168">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:TrayIcon />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
    
                        <ItemsControl x:Name="PinnedTray" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TrayIcon />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
    
                    <!-- Módulos de estado: cada uno abre su propio panel y se activa desde el Hub -->
                    <Button x:Name="NetworkButton" Style="{StaticResource TaskbarButton}" Width="36" Padding="0"
                            Click="NetworkButton_Click">
                        <TextBlock x:Name="NetworkGlyph" Style="{StaticResource IconText}" Text="&#xE701;" />
                    </Button>
                    <Button x:Name="BluetoothButton" Style="{StaticResource TaskbarButton}" Width="36" Padding="0"
                            ToolTip="{l:T 'Bluetooth'}" Click="BluetoothButton_Click">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE702;" />
                    </Button>
                    <Button x:Name="BrightnessButton" Style="{StaticResource TaskbarButton}" Width="36" Padding="0"
                            ToolTip="{l:T 'Brillo'}" Visibility="Collapsed" Click="BrightnessButton_Click" MouseWheel="BrightnessButton_MouseWheel">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE706;" />
                    </Button>
                    <Button x:Name="VolumeButton" Style="{StaticResource TaskbarButton}" Width="36" Padding="0"
                            ToolTip="{l:T 'Volumen'}" Click="VolumeButton_Click" MouseWheel="VolumeButton_MouseWheel">
                        <TextBlock x:Name="VolumeGlyph" Style="{StaticResource IconText}" Text="&#xE767;" />
                    </Button>
                    <Button x:Name="BatteryButton" Style="{StaticResource TaskbarButton}" Width="36" Padding="0"
                            Visibility="Collapsed" Click="BatteryButton_Click">
                        <TextBlock x:Name="BatteryGlyph" Style="{StaticResource IconText}" />
                    </Button>
    
                    <Button x:Name="ClockButton" Style="{StaticResource TaskbarButton}" Padding="10,0"
                            Click="ClockButton_Click">
                        <StackPanel x:Name="ClockContent" Orientation="Horizontal">
                            <StackPanel x:Name="ClockPanel" VerticalAlignment="Center">
                                <TextBlock x:Name="TimeText" HorizontalAlignment="Right" FontSize="12" />
                                <TextBlock x:Name="DateText" HorizontalAlignment="Right" FontSize="12" />
                            </StackPanel>
                            <!-- Notificaciones pendientes en el centro de WINX -->
                            <Border x:Name="NotificationBadge" Visibility="Collapsed" Margin="8,0,0,0" MinWidth="18" Height="18"
                                    CornerRadius="9" Padding="5,0" VerticalAlignment="Center" Background="{DynamicResource WinxAccentBrush}">
                                <TextBlock x:Name="NotificationCount" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
    
                    <Border x:Name="ShowDesktopArea" Width="12" Background="Transparent" ToolTip="{l:T 'Mostrar escritorio'}"
                            MouseLeftButtonUp="ShowDesktop_Click">
                        <Border x:Name="ShowDesktopLine" Width="1" Height="16" HorizontalAlignment="Right"
                                Background="{DynamicResource WinxTaskbarBorderBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</appbar:AppBarWindow>
