<ui:FluentWindow x:Class="Strata.Shell.Files.MediaViewerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:l="clr-namespace:Strata.Shell.Services.Localization;assembly=StrataUI"
                 xmlns:controls="clr-namespace:Strata.Shell.Controls;assembly=StrataUI"
                 xmlns:files="clr-namespace:Strata.Shell.Files"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{l:T 'Visor'}"
                 Icon="pack://application:,,,/Assets/strataui.ico"
                 Width="1100" Height="740" MinWidth="520" MinHeight="380"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">
    <Grid x:Name="Root" Background="{DynamicResource StrataHubTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="ViewerTitleBar" Grid.Row="0" Title="{l:T 'Visor'}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="{x:Static controls:Logo.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- El visor se va de este marco a la pantalla completa y vuelve -->
        <Border Grid.Row="1">
            <files:MediaViewer x:Name="Viewer" />
        </Border>
    </Grid>
</ui:FluentWindow>
