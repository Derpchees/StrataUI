<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Estilos de Archivos: la ventana (barra lateral, pestañas, comandos) y cada panel de carpeta -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Botón de la barra de herramientas: solo ícono, cuadrado y plano -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón con ícono y texto de la barra de comandos (Nueva carpeta, Ordenar) -->
    <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor de vista (lista / cuadrícula, ocultos, extensiones, vista doble): marcado con el acento -->
    <Style x:Key="ViewToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StrataAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Entrada de la barra lateral: la carpeta actual lleva la marca de acento, como el Hub -->
    <Style x:Key="SideItem" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="12,0" MinHeight="36">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource StrataAccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <!-- Algo arrastrado encima que se puede soltar aquí -->
                        <Trigger Property="Tag" Value="drop">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrataAccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fila o mosaico de un archivo: resaltado suave y la selección teñida con el acento -->
    <Style x:Key="FileItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="Sel" CornerRadius="6" Background="{DynamicResource StrataAccentBrush}" Opacity="0" />
                        <Border x:Name="Edge" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource StrataAccentBrush}" Opacity="0" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Sel" Property="Opacity" Value="0.18" />
                            <Setter TargetName="Edge" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridItem" TargetType="ListBoxItem" BasedOn="{StaticResource FileItem}">
        <Setter Property="Margin" Value="3" />
    </Style>

    <!-- Lo oculto y lo cortado se ve tenue -->
    <Style x:Key="FileContent" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                <Setter Property="Opacity" Value="0.6" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCut}" Value="True">
                <Setter Property="Opacity" Value="0.45" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Marca del estado en la nube sobre el ícono: nube (solo en línea) o visto verde (en el equipo;
         relleno si está fijado), como en el Explorador -->
    <Style x:Key="CloudBadge" TargetType="ui:SymbolIcon">
        <Setter Property="Symbol" Value="CheckmarkCircle24" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Setter Property="Visibility" Value="{Binding HasCloudState, Converter={StaticResource BoolToVis}}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Cloud}" Value="OnlineOnly">
                <Setter Property="Symbol" Value="Cloud24" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Cloud}" Value="Pinned">
                <Setter Property="Filled" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
